# Roksal Railing Manager — Environment Variables
# Baza podatkov (PostgreSQL — issue #4: produkcijski vir je zunanji trajni PG).
# Lokalni dev: `bun run db:up` (embedded PG :5433) → postgresql://roksal:roksal@localhost:5433/roksal_dev
DATABASE_URL="postgresql://roksal:roksal@localhost:5432/roksal_prod"

# NextAuth.js (opcijsko — za prihodnjo avtentikacijo)
# Generiraj z: openssl rand -base64 32
# Podpisovanje sejnih žetonov — OBVEZNO, brez tega prijava ne deluje (fail closed).
# Generiraj z: openssl rand -base64 32
SESSION_SECRET=""
NEXTAUTH_SECRET=""

# Sol za hashe API ključev (mobilni klient) — v produkciji obvezno svoja vrednost.
# Generiraj z: openssl rand -base64 24
API_KEY_PEPPER=""

# VLM model za AI material takeoff (opcijsko)
ZAI_VISION_MODEL="glm-4.5v"

# URL aplikacije
NEXTAUTH_URL="http://localhost:3000"

# OpenWeather API (opcijsko — za vetrne podatke)
# Pridobi na: https://openweathermap.org/api
OPENWEATHER_API_KEY=""

# Port (privzeto 3000)
PORT=3000
