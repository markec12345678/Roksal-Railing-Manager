  profilId    String?
  // R121: bajti v object storage; imageUrl = zapuščinska vrstica (backfill).
  imageUrl    String? // zapuščina: base64 PNG (video frame + canvas overlay)
  storageKey  String?
  mime        String?
  sizeBytes   Int?
  sha256      String?
  tocke       String // JSON: [{x,y,label}]
  meritve     String? // JSON: [{a:{x,y}, b:{x,y}, dolzinaMm, oznaka}]
  kalibracija String? // JSON: {pixelsPerCm}
  opombe      String?
