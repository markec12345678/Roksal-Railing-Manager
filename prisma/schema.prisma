  storageKey String?
  mime       String?
  sizeBytes  Int?
  sha256     String?
  povzetek   String? // besedilni opis skice
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// 14. GALERIJA REALIZACIJ
