// Roksal Field v3.0 - PostgreSQL Production Schema (issue #4, korak 1)
//
// Prodajni vir podatkov je ZUNANJI TRAJNI PostgreSQL (Vercel Postgres / Neon).
// S+8.2 (čiščenje prehodne poti): prehodni SQLite demo način je odstranjen —
// ta shema je edina, brez variant (docs/POSTGRES-MIGRATION.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. UPORABNIKI IN VLOGE
// ============================================

enum UserRole {
  ADMIN
  VODJA
  MONTER
  SKLADISCE
}

model Profile {
  id           String   @id @default(cuid())
  ime          String
  email        String   @unique
  vloga        UserRole @default(MONTER)
  /// scrypt hash gesla: `scrypt$N$r$p$salt$hash`. Null = račun brez gesla
  /// (še ne more se prijaviti) — nastavi ga s `bunx tsx tools/create-admin.ts`.
  passwordHash String?
  telefon      String?
  ekipaId      String?
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // R134 (§9): življenjski cikl računa — vse Null/false = aktiven račun.
  // assertSessionAlive preverja status ob VSAKEM zahtevku → deaktivacija/
  // zaklep učinkujeta TAKOJ na že izdane žetone (hard requirement §9).
  deactivatedAt      DateTime? // deaktivacija (offboarding) — prijava + žive seje mrte
  lockedAt           DateTime? // zaklenjen račun (admin akcija) — prijava blokirana
  mustChangePassword Boolean   @default(false) // admin reset gesla → zamenjava ob naslednji prijavi
  inviteTokenHash    String?   @unique // sha256(token) — aktivacijski žeton povabila (čistega NIKOLI v bazi)
  inviteExpiresAt    DateTime? // povabilo poteče (privzeto 7 dni)
  invitedBy          String? // e-pošta povabljajočega (kontekst, brez FK)
  invitedAt          DateTime?

  projects             Project[]              @relation("InstallerProjects")
  leads                Project[]              @relation("ManagerProjects")
  auditLogs            AuditLog[]
  crew                 Crew?                  @relation(fields: [ekipaId], references: [id])
  leadsCrew            Crew[]                 @relation("CrewLeader")
  schedules            InstallationSchedule[] @relation("MonterSchedules")
  sessions             UserSession[]
  equipmentEvents      EquipmentEvent[] // R145 §31 — pregledi/kalibracije, ki jih je zabeležil
  qualityControls      QualityControl[] // R146 §27 — preverbe, ki jih je odobril
  installationEvidence InstallationEvidence[] // R147 §28 — dokazila, ki jih je ustvaril
  syncTombstones       SyncTombstone[] // R148 §36 — grobnice sync, ki jih je ustvaril
  operatedOperations   ProductionOperation[] @relation("ProductionOperationOperator") // R378 §10 — proizvodne operacije, ki jih je izvajal
  installedRecords     InstallationRecord[] @relation("InstallationRecordMonter") // R378 §9 — as-installed zapisi, kjer je monter
  ownedLeads           Lead[] @relation("LeadOwner") // R382 §13 — sleadi, ki jih ta uporabnik vodi (owner)
}

/// #5 §2 — Session revocation: registracija izdanih sejnih žetonov.
///
/// Žeton sam je še vedno brezstanjski HMAC (middleware ga preveri brez baze),
/// ampak ruta (authenticate) zahteva ŽIV vnos v tej tabeli:
///   • jti v žetonu = id vrstice — brez njega je žeton NEVELJAVEN (fail-closed);
///   • revokedAt != null → revoke ene naprave (logout te naprave) ali vseh
///     (odjava vseh naprav, menjava gesla, deaktivacija);
///   • expiresAt = ista vrednost kot exp v žetonu — pregone napihnjenih vrstic
///     omogoča lenobno čiščenje ob novi prijavi istega profila.
model UserSession {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([profileId, revokedAt])
  @@index([expiresAt])
}

// ============================================
// 2. STRANKE
// ============================================

model Customer {
  id        String   @id @default(cuid())
  ime       String
  naslov    String
  telefon   String?
  email     String?
  createdAt DateTime @default(now())

  // V4.2 — CRM razširitev
  status         String    @default("AKTIVEN") // AKTIVEN | NEAKTIVEN | POTENCIALEN | ARHIVIRAN
  kontaktnaOseba String? // npr. "Janez Novak (predsednik uprave)"
  opomnikDatum   DateTime? // opomnik za ponovni kontakt
  opomnikOpis    String? // "Letni pregled balkonov"
  zadnjiKontakt  DateTime?
  opombeCRM      String? // interne opombe (ne za stranko)
  kategorija     String? // "Stanovanjska skupnost" | "Posameznik" | "Podjetje"

  projects Project[]
  quotes    Quote[] // R373 — ponudbe stranke (§3)
  addresses    CustomerAddress[] // R382 §13 — ločeni naslovi (kontaktni/računski/montažni)
  opportunities Opportunity[] // R382 §13 — poslovne priložnosti stranke
}

// R382 (issue #13, korak R169 iz §13) — LEAD: surovi stik PRED stranko.
// §13: trenutni Customer model je "preveč blizu končni stranki" — povpraševanje
// (telefon/mail/sprehod) se je zapisovalo DIREKTNO v stranke, brez sledi, od kod
// je prišlo. Lead je vhodni lijak: source (odkod), kontakt (kdo), tip
// povpraševanja (česa), status (kje v predkvalifikaciji), owner (kdo vodi),
// nextActionAt (kdaj naslednji korak). Stranka še NE obstaja — nastane š ob
// PRETVORJEN (skupaj z Opportunity, isto transakcijo, crm-store).
//
// Statusi (manjši kot §13 lifecycle — ta živi na OPPORTUNITY.stage, ki ima
// polje "stage" v specu; Lead.status je PREDkvalifikacijski nabor, ne druga
// kopija prodajne cevi): NOV | KONTAKTIRAN | PRETVORJEN | ZAVRNJEN.
// CHECK v migraciji; matrika prehodov = src/lib/crm-pipeline.ts (EN VIR).
model Lead {
  id               String    @id @default(cuid())
  // Odkod je povpraševanje prišlo ( starter nabor + DRUGO — v repu NI
  // obstoječega CRM nabora virov, enaka iskrena odločitev kot prioritete
  // R378; širjenje = nova migracija, ne tiha inflacija):
  // WEB | TELEFON | EMAIL | PREPOROKA | OBSTOJECA_STRANKA | SEJEM | DRUGO
  source           String    @default("DRUGO")
  // Kontakt (§13): ime + telefon/email — OSEBA, ne stranka (stranka je pravna
  // entiteta z naslovi; lead je človek, ki je vprašal).
  ime              String
  telefon          String?
  email            String?
  // Česa se sprašuje: BALKON | TERASA | STOPNISCE | OGRAJA | DRUGO (CHECK).
  tipPovprasevanja String    @default("DRUGO")
  status           String    @default("NOV")
  // Lastnik sleada (§13 owner) — Profile.id; NULL = neprevzet (iskreno,
  // §8: nič ne izmišljujemo). Odhod lastnika (delete) NE pobije sleada.
  ownerId          String?
  // Opomnik naslednje akcije (§13 nextActionAt) — NULL = ni dogovorjene
  // naslednje akcije (iskreno, ne izmišljan datum).
  nextActionAt     DateTime?
  opombe           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner         Profile?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  opportunities Opportunity[] // priložnosti, rojene iz tega sleada (PRETVORJEN)

  @@index([status, nextActionAt])
  @@index([ownerId])
}

// R382 (issue #13, korak R169 iz §13) — OPPORTUNITY: poslovna priložnost.
// §13 polja: leadId (izvor — NULL = direktna/repeat poslovna priložnost
// obstoječe stranke), customerId (NULL dokler ni stranke — zgodnja faza
// pogajanj še NI stranka; ob ACCEPTED OBVEZNO, fail-closed v crm-store),
// potential project (naziv/opis), estimated value (ocena — Decimal(12,2),
// denarni domene R380; NULL = neznana, §8 — nikoli 0 kot "neznano"),
// stage (§13 lifecycle — spodaj), probability (verjetnost 0–100 — §13
// izrecno: "ni potrebna kot napoved, lahko pa kot CRM polje BREZ poslovne
// logike" — int, ne Decimal: to je mnenje, ne izračun), loss reason
// (obvezen pri LOST — crm-store), convertedProjectId (nastavi se ob
// ACCEPTED — nastanek projekta je ISTA transakcija).
//
// Stage lifecycle §13 (EXACT iz speca, EN VIR matrica v crm-pipeline.ts):
//   NEW → CONTACTED → SITE_SURVEY → QUOTE → FOLLOW_UP → ACCEPTED / LOST
model Opportunity {
  id                 String    @id @default(cuid())
  leadId             String?
  customerId         String?
  naziv              String
  opis               String?
  ocenjenaVrednost   Decimal?  @db.Decimal(12, 2)
  stage              String    @default("NEW")
  verjetnost         Int?
  razlogIzgube       String?
  convertedProjectId String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // RESTRICT (ne SetNull): sprejeta priložnost DOKAZUJE nastanek projekta —
  // invariant stage=ACCEPTED ⇒ convertedProjectId NOT NULL ne sme tiho
  // razpasti. Projekta NI mogoče brisati prek API-ja (pregledano R382 —
  // DELETE pot ne obstaja), RESTRICT torej ne zadržuje nobenega legalnega
  // toka, zapira pa tihle razpad resnice.
  convertedProject Project?  @relation("OpportunityConversion", fields: [convertedProjectId], references: [id], onDelete: Restrict)

  @@index([stage, createdAt])
  @@index([customerId])
  @@index([leadId])
}

// R382 (issue #13, korak R169 iz §13) — LOČENI NASLOVI STRANKE.
// §13: "Customer mora ločiti vsaj: contact/mailing address; billing
// address; installation/site address." Do R382 je bil NASAMO en flat
// Customer.naslov — računski naslov in montažna lokacija sta bila ISTA
// resnica. Ločitev:
//   KONTAKTNI  — kontakt/mailing (kam pošiljamo pošto);
//   RACUNSKI   — billing (kam se izstavi račun);
//   MONTAZNI   — installation/site (kje se montaža izvaja — lahko VEČ naslovov:
//                upravniki stanovanjskih skupnosti imajo več objektov).
// CHECK tip + partial UNIQUE (customerId, tip) WHERE jePrivzet v
// migraciji (strežniška plast demote-a starih privzetih; DB je zadnja
// linija).
//
// LEGACY SINHRON (dokumentirana meja, ne tiha dvojna resnica):
// Customer.naslov (NOT NULL, od init migracije — mobilni klienti/PDF ga
// berejo) ostane FLAT PRIKAZNO polje: ob zapisu/brisanju PRIVZETEGA
// KONTAKTNI naslova ga crm-store posodobi v ISTI transakciji. Brez
// privzetega KONTAKTNI nosi zadnjo znano vrednost (legacy prikaz). Kanon
// §1 (ne ruši determinističnih temeljev) + §8 (brez izmišljanja).
model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  tip        String   @default("KONTAKTNI")
  naslov     String
  kraj       String?
  postnaSt   String?
  jePrivzet  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, tip])
}

// ============================================
// 3. PROJEKTI - Centralno vozlišče
// ============================================

enum ProjectStatus {
  NACRTOVANO
  V_TEKU
  ZAKLJUCENO
  USTAVLJENO
  ZA_MONTAZO // V4.1 — podpisano, čaka na montažo
  V_IZDELAVI // V6 — material v izdelavi/dobavi
  MONTIRANO // V6 — montaža zaključena
}

model Project {
  id            String        @id @default(cuid())
  customerId    String
  nazivProjekta String
  status        ProjectStatus @default(NACRTOVANO)
  monterId      String?
  vodjaId       String?
  ekipaId       String?
  datumMontaze  DateTime?
  opombe        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // R121: UNIQUE — ena mobilna kopija = EN projekt (replay/dvojni sync ne sme
  // ustvariti dvojnika). Pred migracijo preverjeno: 0 duplikatov v produkciji.
  // NULL vrednosti (ročno ustvarjeni projekti) so v PG dovoljene večkrat.
  mobileProjectId   String? @unique
  originalImagePath String?
  geminiEstimate    String?
  latitude          Float?
  longitude         Float?
  projectData       String?

  // PORTAL STRANKE — javna stran za sledenje napredku
  // R132 (§7): žeton NI več trajni javni ključ — dobi potek, revokacijo in
  // zadnji dostop; vsak poskus branja gre v PortalAccess dnevnik.
  clientToken           String    @unique @default(cuid())
  clientPortalEnabled   Boolean   @default(false)
  clientTokenExpiresAt  DateTime? // null = brez poteka (zapuščinski žetoni; nova = privzeto 90 dni)
  clientTokenRevokedAt  DateTime? // revokacija = žeton MRTAV (regenerate ga oživi z novim)
  clientTokenLastUsedAt DateTime? // zadnji uspešen dostop (telemetrija za pisarno)
  clientNotes           String? // sporočilo monterja, vidno stranki
  estimatedPrice        Decimal? @db.Decimal(12, 2) // predvidena cena, vidna stranki

  // R133 (§8): scoped MERILNI žeton — LOČEN od portal žetona. Portal povezava
  // pomeni "vidi napredek projekta"; merilna povezava pomeni "lahko pošlje
  // meritev" — dve različni zmožnosti, dva žetona, dva neodvisna življenjska
  // cikla (potek/revokacija/onemogočeno). Revokacija portala ne mori merilne
  // povezave in obratno.
  measureToken           String?   @unique // null = merilna povezava še nikoli izdana
  measureEnabled         Boolean   @default(false)
  measureTokenExpiresAt  DateTime? // null = brez poteka (zapuščinski; nova = privzeto 90 dni)
  measureTokenRevokedAt  DateTime? // revokacija = žeton MRTAV (regenerate ga oživi)
  measureTokenLastUsedAt DateTime? // zadnja uspešna samomeritev (telemetrija)

  // V4.1 — POST-SIGNATURE AUTOMATION LAYER
  dealLocked          Boolean   @default(false) // true po podpisu — nič več editanja
  dealLockedAt        DateTime?
  dealSignedBy        String? // ime/podpis stranke
  dealSignedByMonter  String? // ime monterja
  dealSignatureIp     String? // IP naslov ob podpisu
  dealSignatureDevice String? // User-Agent ob podpisu
  bomDraftJson        String? // BOM (Bill of Materials) draft JSON — ne naročilo še
  marginLocked        Decimal? @db.Decimal(12, 2) // zaklenjena marža ob podpisu

  // FOLLOW-UP PONUDBE — sledenje odzivu stranke na poslano ponudbo
  followUpDate   DateTime? // kdaj poslati/narediti spomnik
  followUpOpomba String? // kratka opomba k spomniku

  // R148 (issue #5 §36 — Mobile sync conflict model): monotoni števec zapisov
  // SINHRONIZACIJE (rasle samo ob sync zapisih — kurzor za delta sync +
  // konflikti prek baseRevision). Nič ne izmišljujemo: 0 = brez sync zapisov.
  syncRevision Int @default(0)

  customer             Customer               @relation(fields: [customerId], references: [id])
  monter               Profile?               @relation("InstallerProjects", fields: [monterId], references: [id])
  vodja                Profile?               @relation("ManagerProjects", fields: [vodjaId], references: [id])
  measurements         Measurement[]
  documents            Document[]
  materials            MaterialUsage[]
  auditLogs            AuditLog[]
  inventoryMoves       InventoryMovement[]
  stockLedger          StockLedger[]
  lotAllocations       LotAllocation[]
  arSnapshots          ArSnapshot[]
  sketches             Sketch[]
  slopes               Slope[]
  galleryItems         GalleryItem[]
  photos               ProjectPhoto[]
  signatureAudits      SignatureAudit[]
  materialOrders       MaterialOrder[]
  schedules            InstallationSchedule[]
  punchItems           PunchItem[]
  invoices             Invoice[]
  siteSurvey           SiteSurvey?
  portalAccess         PortalAccess[]
  qualityControls      QualityControl[] // R146 §27 — preverbe kakovosti projekta
  installationEvidence InstallationEvidence[] // R147 §28 — montažna dokazila projekta
  syncTombstones       SyncTombstone[] // R148 §36 — grobnice sync (SetNull preživijo brisanje projekta)
  quotes               Quote[] // R373 §3 — kanonične ponudbe projekta
  bom                  BOM? // R376 §6 — kanonični BOM nosilec (EN na projekt, UNIQUE projectId)
  productionOrders     ProductionOrder[] // R378 §10 — proizvodni nalogi nad odobrenim BOM
  installationRecords  InstallationRecord[] // R378 §9 — as-installed resnica projekta (verzionirana)
  convertedFromOpportunity Opportunity? @relation("OpportunityConversion") // R382 §13 — nastal iz SPREJETE priložnosti (EN na projekt, UNIQUE convertedProjectId)
}

// ============================================
// 4. MERITVE - AR/LiDAR podpora
// ============================================

model Measurement {
  id           String   @id @default(cuid())
  projectId    String
  dolzinaMm    Int
  visinaMm     Int
  lidarScanUrl String?
  arMetadata   String?
  gpsLokacija  String?
  createdAt    DateTime @default(now())
  createdBy    String?

  // R133 (§8): duplicate protection — deterministični hash (projekt + točke +
  // dolžina + višina). Identična pošiljanja v oknu 30 min vrnejo OBSTOJEČO
  // meritev (200, duplicate:true) namesto nove vrstice.
  dedupeHash String?

  // R153 (§19): status meritve — perzistenten življenjski cikel
  // OSNUTEK → POTRJENA → ARHIVIRANA (→ ponovno odprtje le z obvezno opombo).
  // Prej izključno UI koncept (po reloadu izginil); zdaj stolpec + revizijska
  // sled v AuditLog (MEASUREMENT_STATUS, oldValue/newValue).
  status          String    @default("OSNUTEK")
  statusNote      String?
  statusUpdatedAt DateTime?

  // R276 (issue #16 §6 — zgodovina verzij; register #17-E): meritve se NE
  // tiho prepisujejo — korekcija = NOVA vrstica v verigi (R153 kanon:
  // "popravki gredo skozi vodjo (nov vnos)"; nobena ruta ne spreminja
  // dimenzij). verzija = zaporedna številka znotraj verige (1, 2, 3 …);
  // null = nastalo PRED verzioniranjem (iskrena praznina — brez backfill,
  // brez izmišljene zgodovine). predhodnikId UNIQUE = enojna veriga brez
  // razvejanja (fork = P2002 → 409, tudi race — DB nivo). korenId = id prve
  // vrstice verige (koren = null) — O(1) fetch verige, integriteta po vzorcu
  // R121 DocumentVersion @@unique([documentId, version]). vir = strežniško
  // IZPELJAN izvor (MANUAL/PHOTO_CV/ARCORE_DEPTH, kontrakt #16 §2) — klient
  // ga ne more podati (ne ponareljiv); null pri legacy arMetadata = ni vir
  // resnice (nikoli ugibanje). Odločitve O1–O9: docs/MEASUREMENT-HISTORY.md.
  verzija      Int?
  predhodnikId String? @unique
  korenId      String?
  vir          String?

  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installationEvidence InstallationEvidence[] // R147 §28 — merilni dokazi povezani z dokazili

  predhodnik Measurement?  @relation("MeritevVerzije", fields: [predhodnikId], references: [id], onDelete: SetNull)
  nasledniki Measurement[] @relation("MeritevVerzije")

  @@index([projectId, dedupeHash])
  @@index([projectId, status])
  @@index([korenId, verzija])
  @@index([projectId, verzija])
}

// ============================================
// 5. ZALOGA IN INVENTAR
// ============================================

model Inventory {
  id              String   @id @default(cuid())
  sifraMateriala  String   @unique
  naziv           String
  tip             String
  kolicinaZaloga  Decimal  @default(0) @db.Decimal(12, 3)
  enota           String
  minimalnaZaloga Decimal  @default(5) @db.Decimal(12, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // R380 (issue #13 §12) — KONVERZIJA ENOT: VSI nullable — obstoječi
  // materiali teh podatkov NIMAJO in izumljanje bi bilo laž (§8 honest
  // NULL). Ko je polje prisotno, velja kanonična enota (CHECK v migraciji
  // + src/lib/units.ts — EXACT zapis, 'm²' ne 'm2'). Legacy 'enota' zgoraj
  // ostaja prost string (produkcijski podatki so pred kanonom).
  purchaseUnit       String?   // enota nabave pri dobavitelju (kanonična)
  stockUnit          String?   // enota vodenja zaloge (kanonična)
  consumptionUnit    String?   // enota porabe v BOM/produkciji (kanonična)
  supplierPackSize   Decimal?  @db.Decimal(12, 3) // kosov (stockUnit) na enoto nabave — CHECK > 0
  conversionFactor   Decimal?  @db.Decimal(12, 6) // množilnik nabavna količina → zaloga — CHECK > 0
  precision          Int?      // decimalke količin tega materiala — CHECK 0–6
  rounding           String?   // GORI | DOL | NAIJBLIZJE (vir nabora: decimal-policy)

  usages        MaterialUsage[]
  movements     InventoryMovement[]
  ledgerEntries StockLedger[]
  prices        MaterialPrice[]
  orderItems    MaterialOrderItem[]
  lots          InventoryLot[]
  bomLines      BOMLine[] // R376 §6 — kanonične BOM vrstice, vezane EXACT na sifraMateriala
}

// ============================================
// 6. PORABA MATERIALA NA PROJEKTU
// ============================================

model MaterialUsage {
  id                 String   @id @default(cuid())
  projectId          String
  inventoryId        String
  porabljenaKolicina Decimal @db.Decimal(12, 3)
  datumVpisa         DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

// ============================================
// 7. PREMIKI ZALOGE
// ============================================

model InventoryMovement {
  id          String   @id @default(cuid())
  inventoryId String
  projectId   String?
  /// Naročilo, ki je povzročilo premik (dobava). Nullable, ker so ročni
  /// prevzemi/izdaje brez naročila. Dodano, ker je material-orders/route.ts
  /// že ves čas pisal `orderId` — brez tega polja je bila vsaka dobava
  /// tipkovna napaka in 500 ob prejemu naročila.
  orderId     String?
  kolicina    Decimal  @db.Decimal(12, 3)
  tipPremika  String
  createdAt   DateTime @default(now())
  createdBy   String?

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])

  @@index([orderId])
}

// ============================================
// 7b. IMMUTABLE STOCK LEDGER (issue #4, §4 — transakcijska zaloga)
// ============================================
// Vsaka sprememba zaloge = nespremenljiv dogodek s predznacenom deltami in
// bilanco po premiku (balanceAfter). Dogodek IN sprememba balance sta V ISTI
// DB transakciji (src/lib/inventory.ts) — balanca je vedno vsota dogodkov.
// Idempotentnost prejema: unique `idempotencyKey` (npr. "receipt:<orderId>:<itemId>")
// preprecuje dvojni prijem pri retry/double-click/webhook.
enum StockLedgerEventType {
  OPENING
  PURCHASE
  RECEIPT
  RETURN
  RESERVATION
  RELEASE
  ISSUE
  WASTE
  DAMAGE
  ADJUSTMENT
  PROJECT_ALLOCATION
}

model StockLedger {
  id             String               @id @default(cuid())
  inventoryId    String
  eventType      StockLedgerEventType
  /// Predznacena delta: pozitivno = prihod, negativno = odhod.
  kolicina       Decimal  @db.Decimal(12, 3)
  enota          String
  /// Bilanca zaloge TAKOJ po tem dogodku (znotraj iste transakcije).
  balanceAfter   Decimal  @db.Decimal(12, 3)
  /// Referenca vira dogodka.
  orderId        String?
  orderItemId    String?
  projectId      String?
  /// Profile.id akterja (ali "system" za backfill/seed — ni FK, ker sistem nima uporabnika).
  actorId        String?
  /// Razlog/opomba (npr. "prejem naročila 2026-001", "fizična inventura").
  reason         String?
  /// Idempotency kljuc — unique. Npr. "receipt:<orderId>:<orderItemId>".
  idempotencyKey String?              @unique
  createdAt      DateTime             @default(now())

  inventory   Inventory       @relation(fields: [inventoryId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])
  /// Šarža dogodka (R144, §24) — nasprona stran InventoryLot.ledgerEvents.
  lot         InventoryLot?   @relation(fields: [lotId], references: [id])
  /// Alokacije, ki izhajajo iz tega dogodka (odhodki se razdelijo čez šarže).
  allocations LotAllocation[]

  /// Šarža, iz katere je dogodek prišel/odšel (R144, §24). Prihodki: lot vira.
  /// Odhodki (FIFO alokacija čez več lotov): PRIMARY lot (najstarejši vpleten).
  lotId String?

  @@index([inventoryId, createdAt])
  @@index([eventType])
  @@index([orderId])
  @@index([lotId])
}

// ============================================
// 7b-LOT. ŠARŽE / LOT TRACEABILITY (issue #5, §24 — R144)
// ============================================
// Ciljna sled (addendum #5 §24): Project → Product → BOM → Material →
// Supplier/Batch → Installation. Vsak prihod zaloge (OPENING, PURCHASE,
// RECEIPT, RETURN, pozitiven ADJUSTMENT) kredira šaržo; vsak odhod (ISSUE,
// WASTE, DAMAGE, RESERVATION, negativen ADJUSTMENT) alokira DETERMINISTIČNO
// FIFO po deliveryDate ASC, createdAt ASC, id ASC (pravilo je čista funkcija,
// brez naključja). LotAllocation povezuje odhodni StockLedger dogodek z
// šaržami, iz katerih je material dejansko prišel.
//
// Backfill (migracija r144): artikli z zalogo pred uvedbo šarž dobijo ENO
// "LEGACY" šaržo (lotNumber = 'LOT-LEGACY-' || id, dobava = createdAt,
// dobavitelj/cena NULL — iskreno "neznana poreklo", brez izmišljanja podatkov).
// FIFO jo postavi PRVO (najstarejši deliveryDate), kar je tudi pravilno
// skladiščno vedenje (najstarejša zaloga gre ven prva).
model InventoryLot {
  id                String   @id @default(cuid())
  inventoryId       String
  /// Človeku berljiva št. šarže, unikatna per artikel. Pri prejemu naročila:
  /// 'LOT-<orderId zadnjih 8>-<zap. postavke>' (deterministično, idempotentno
  /// po (orderId, orderItemId)). Ročni prihod: 'LOT-M-<kratki unikat>'.
  lotNumber         String
  /// Poreklo — dobavitelj (NULL = notranja/legacy šarža, iskreno dokumentirano).
  supplierId        String?
  /// Naročilo, iz katerega je šarža prišla.
  orderId           String?
  orderItemId       String?
  /// Datum prejema/dobave (FIFO primarni ključ).
  deliveryDate      DateTime @default(now())
  /// Nabavna cena na enoto ob prejemu (EUR) — iz MaterialOrderItem.cena.
  purchasePrice     Decimal? @db.Decimal(12, 2)
  /// Originalna količina šarže ob kreaciji.
  quantityInitial   Decimal  @db.Decimal(12, 3)
  /// Trenutno preostanek = quantityInitial - Σ negativnih + Σ pozitivnih alokacij.
  quantityRemaining Decimal  @db.Decimal(12, 3)
  /// ACTIVE | EXHAUSTED (remaining = 0) | CLOSED (ročno zaprta, ne sodeluje v FIFO).
  status            String   @default("ACTIVE")
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inventory    Inventory          @relation(fields: [inventoryId], references: [id])
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  order        MaterialOrder?     @relation(fields: [orderId], references: [id])
  orderItem    MaterialOrderItem? @relation(fields: [orderItemId], references: [id])
  allocations  LotAllocation[]
  ledgerEvents StockLedger[]

  @@unique([inventoryId, lotNumber])
  @@index([inventoryId, status])
  @@index([supplierId])
  @@index([orderId])
  @@index([deliveryDate])
}

// Alokacija odhoda na šaržo: negativna količina = poraba iz šarže, pozitivna
// = vračilo v šaržo. ledgerId poveže z odhodnim StockLedger dogodkom →
// polna sled Project (projectId) → StockLedger → LotAllocation → InventoryLot
// → Supplier/MaterialOrder.
model LotAllocation {
  id        String   @id @default(cuid())
  lotId     String
  /// StockLedger dogodek, ki je porabil/vrnil količino.
  ledgerId  String?
  /// Kopija eventType (berljivost DTO — brez joina za osnovni prikaz).
  eventType String
  /// Predznačena: minus = odhod iz šarže, plus = vračilo v šaržo.
  kolicina  Decimal  @db.Decimal(12, 3)
  projectId String?
  actorId   String?
  createdAt DateTime @default(now())

  lot     InventoryLot @relation(fields: [lotId], references: [id])
  ledger  StockLedger? @relation(fields: [ledgerId], references: [id])
  project Project?     @relation(fields: [projectId], references: [id])

  @@index([lotId, createdAt])
  @@index([projectId])
  @@index([ledgerId])
}

// ============================================
// 7c. SEKVENCA ŠTEVILKENJ (issue #4, §12 — concurrency-safe invoice numbering)
// ============================================
// Atomski povečevalnik za stevilke dokumentov ("RACUN:2026" → 1, 2, …).
// Alokacija poteka z UPDATE ... RETURNING v transakciji (src/lib/numbering.ts),
// unique constraint na Invoice.stevilka ostane zadnja linija obrambe.
model NumberSequence {
  id        String   @id @default(cuid())
  /// Npr. "RACUN:2026", "PREDRACUN:2026".
  seqKey    String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ============================================
// 8. DOKUMENTI
// ============================================

enum DocumentType {
  TEHNICNI_LIST
  PRIMOPREDAJA
  E_RACUN
  ZAPISNIK_NAVORA
}

model Document {
  id           String       @id @default(cuid())
  projectId    String
  pdfUrl       String? // ZASTARELO (R121): prej samo ime brez artefakta; nova dokumenta pišejo storageKey
  storageKey   String? // R121: object storage ključ PDF artefakta
  sha256       String? // R121: SHA-256 aktualne verzije (pravna integriteta)
  signatureUrl String?
  tipDokumenta DocumentType @default(TEHNICNI_LIST)
  status       String       @default("GENERIRANO")
  createdAt    DateTime     @default(now())

  versions DocumentVersion[]
  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// 8a. R121 — VERZIJE DOKUMENTOV (pravi PDF artefakt v object storage)
// ============================================
// Kanonična pot: canonical data → renderer → PDF bytes → SHA-256 →
// object storage → DocumentVersion. DB hrani SAMO metadata; bajti v
// object storage (src/lib/object-storage.ts). Verzija se poveča ob vsaki
// regeneraciji — prejšnje verzije ostajo (neizbrisna revizijska sled).
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int // 1, 2, 3 … znotraj dokumenta
  storageKey String // ključ PDF v object storage
  mime       String   @default("application/pdf")
  sizeBytes  Int
  sha256     String // SHA-256 bajtov artefakta
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

// ============================================
// 9. AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  /// Null = sistemski dogodek (brez uporabnika). Prej je bil "system" string,
  /// ki ni obstajal v Profile in je padal na FK constraint (issue #4, §13).
  userId    String?
  projectId String?
  akcija    String
  oldValue  String?
  newValue  String?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  user    Profile? @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  /// R136 (§18): revizijski dnevnik je bil brez VSEH indeksov (sekvenčni scan
  /// na vsakem ogledu sledi). Branje teče po projektu + kronološko.
  @@index([projectId, timestamp])
  /// Pregled po akciji (npr. vsi USER_DEACTIVATE dogodki) — varnostna analiza.
  @@index([akcija, timestamp])
}

// ============================================
// 10. OBVESTILA
// ============================================

// R143 (issue #5 §29): življenjski cikel obvestila — DETERMINISTIČEN stroj s
// prehodi samo NAPREJ (glej src/lib/notifications.ts):
//   QUEUED → SENT → DELIVERED → OPENED, ali QUEUED → FAILED (retry politika).
//   • QUEUED    — vrstica zapisana, kanal je še ni oddal (dispatch korak)
//   • SENT      — kanal jo je oddal (in-app: vidna na prvi pridobitvi)
//   • DELIVERED — klient jo je dejansko POBRAL (ack na GET)
//   • OPENED    — uporabnik jo je odprl/prebral (isRead=true, terminalno)
//   • FAILED    — dispatch je po maxRetries poskusih spodletel (terminalno,
//                 lastError je sanitiziran — §22, brez stacka)
enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  FAILED
}

model Notification {
  id              String             @id @default(cuid())
  // Naslovnik: ALI posamezen profil (userId), ALI vloga (recipientRole) —
  // XOR (določa queueNotifications). 'skladisce' pseudo-uporabnik iz starejše
  // kode ostane bralcu neviden (orphan, dokumentirano R143) — nove vrstice so
  // naslovljene prek recipientRole (SKLADISCE), kar daje realno občinstvo.
  userId          String?
  naslov          String
  sporocilo       String?
  isRead          Boolean            @default(false)
  createdAt       DateTime           @default(now())
  // §29 pogodba: status, predloga + verzija, naslovnik, entiteta, korelacija,
  // retry politika + razlog napake, časovni žigi posameznih prehodov.
  status          NotificationStatus @default(QUEUED)
  template        String // ključ iz NOTIFICATION_TEMPLATES (fail-closed, brez 'LEGACY' novih)
  templateVersion Int                @default(1)
  recipientRole   UserRole?
  entityType      String? // npr. 'inventory', 'jobrun'
  entityId        String? // povezani poslovni objekt (navigacija UI)
  correlationId   String? // §22 — povezava klient ↔ logi
  retryCount      Int                @default(0)
  maxRetries      Int                @default(3)
  lastError       String? // sanitiziran (§22) — brez stacka
  sentAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?

  @@index([status, createdAt])
  @@index([userId, isRead])
  @@index([recipientRole, createdAt])
}

// ============================================
// 11. KATALOG PROFILOV OGRAJ (Roksal)
// ============================================

model Profil {
  id         String   @id @default(cuid())
  sifra      String   @unique
  naziv      String
  material   String // alu / inox / wpc / steklo
  kategorija String // npr. "WPC H-Line", "Inox Line", "Steklo"
  visinaMm   Int      @default(1100)
  sirinaMm   Int      @default(140)
  cenaM      Decimal  @db.Decimal(12, 2) // EUR na meter linearni
  barvaRal   String? // privzeta RAL koda
  slikaUrl   String?
  aktivna    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  arSnapshots  ArSnapshot[]
  galleryItems GalleryItem[]
}

// ============================================
// 12. AR POSNETKI (kamera + točke + vizualizacija)
