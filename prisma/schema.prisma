// ============================================
// 16. SLIKE PROJEKTA (pred/med/po montaži)
// ============================================

model ProjectPhoto {
  id         String   @id @default(cuid())
  projectId  String
  kategorija String // "PRED" | "MED" | "PO"
  // R121: bajti v object storage, DB samo metadata. imageData ostane SAMO za
  // zapuščinske vrstice pred backfillom (tools/migrate-base64-to-storage.ts).
  imageData  String?
  storageKey String?
  mime       String?
  sizeBytes  Int?
  sha256     String?
  opomba     String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceBefore InstallationEvidence[] @relation("EvidenceBeforePhoto") // R147 §28 — dokazila s to PRED fotko
  evidenceAfter  InstallationEvidence[] @relation("EvidenceAfterPhoto") // R147 §28 — dokazila s to PO fotko

  @@index([storageKey])
}

// ============================================
// 17. V4.1 — SIGNATURE AUDIT TRAIL (pravno sledenje)
// ============================================

model SignatureAudit {
  id                String   @id @default(cuid())
  projectId         String
  signatureType     String // "CUSTOMER" | "MONTER"
  signedByName      String // ime podpisnika
  signedByRole      String? // "stranka" | "monter" | "vodja"
  signatureImage    String? // ZASTARELO: base64 PNG (R122: migrirano v object storage; ostane za stare zapise)
  storageKey        String? // R121 vzorec: files/signatures/<id>/podpis.png (bajti izven baze)
  mime              String?
  sizeBytes         Int?
  sha256            String? // SHA-256 bajtov (integriteta)
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String? // poenostavljen fingerprint (IP + UA hash)
  geoLatitude       Float?
  geoLongitude      Float?
  pdfUrl            String? // povezava do generiranega PDF (če shranjen)
  pdfHash           String? // SHA-256 hash PDF vsebine za pravno integriteto
  // R373 (issue #13 korak R165, §16 veriga): podpis je vezan na TOČNO to
  // verzijo ponudbe. Nullable — vsi zapisi pred R373 (legacy deal-lock s
  // klientovim quoteData) nimajo verzije in ostanejo nespremenjeni.
  quoteVersionId    String? // kanonična QuoteVersion, nad katero je bil podpis dan
  quoteInputHash    String? // inputHash verzije v trenutku podpisa (dokaz istosti)
  // R376 (issue #13 korak R166, §7 BOM vezava): podpis je vezan tudi na
  // kanonično BOMVersion, ustvarjeno ob zaklepu. Nullable — zapisi pred R376
  // (R374 zaklepi še brez BOM entitete) ostanejo nespremenjeni (brez
  // izmišljanja zgodovine). Mehka referenca (brez FK) — isti vzorec kot
  // quoteVersionId: brisanje BOM verzije ne brše podpisne zgodovine.
  bomVersionId      String?
  isValid           Boolean  @default(true)
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@index([storageKey])
  @@index([quoteVersionId])
  @@index([bomVersionId])
}

// ============================================
// 18. V5 — MATERIAL INTELLIGENCE (dobavitelji, cene, optimizacija)
// ============================================

model Supplier {
  id         String   @id @default(cuid())
  naziv      String   @unique
  kontakt    String?
  email      String?
  telefon    String?
  naslov     String?
  iban       String?
  dobavniRok Int      @default(7) // dni
  popust     Decimal  @default(0) @db.Decimal(5, 2) // % popust za Roksal
  aktivna    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  materialPrices MaterialPrice[]
  orders         MaterialOrder[]
  lots           InventoryLot[]
  bomLines       BOMLine[] // R376 §6 — BOM vrstice z vezavo na dobavitelja
  productMappings ProductSupplierMapping[] // R390 §14 — preslikave kataloških produktov
}

// Cena materiala pri posameznem dobavitelju (zgodovina cen)
model MaterialPrice {
  id           String    @id @default(cuid())
  inventoryId  String
  supplierId   String
  cena         Decimal  @db.Decimal(12, 2) // EUR na enoto
  veljavnostOd DateTime  @default(now())
  veljavnostDo DateTime?
  opomba       String? // npr. "akcijska cena", "letni okvir"
  createdAt    DateTime  @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  supplier  Supplier  @relation(fields: [supplierId], references: [id])

  @@index([inventoryId, supplierId])
  @@index([veljavnostOd])
}

// Naročilo materiala (V5 — iz BOM draft v naročilo)
model MaterialOrder {
  id            String    @id @default(cuid())
  projectId     String?
  supplierId    String
  status        String    @default("OSNUTEK") // OSNUTEK | POSLANO | POTRJENO | DOBLJENO | PREKlicANO
  skupajCena    Decimal  @default(0) @db.Decimal(12, 2)
  datumNarocila DateTime  @default(now())
  datumDobave   DateTime?
  opombe        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project  Project?            @relation(fields: [projectId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    MaterialOrderItem[]
  lots     InventoryLot[]
}

// Posamezna postavka naročila
model MaterialOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  inventoryId String
  kolicina    Decimal  @db.Decimal(12, 3)
  cena        Decimal  @db.Decimal(12, 2) // cena na enoto ob naročilu
  naziv       String // snapshot naziva
  enota       String // snapshot enote
  createdAt   DateTime @default(now())

  order     MaterialOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory Inventory      @relation(fields: [inventoryId], references: [id])
  lots      InventoryLot[]

  @@index([orderId])
}

// ============================================
// 19. V6 — LOGISTICS / ERP (ekipe, oprema, koledar montaže)
// ============================================

model Crew {
  id        String   @id @default(cuid())
  naziv     String   @unique // npr. "Ekipa A", "Ekipa Kranj"
  vodjaId   String? // Profile.id vodje ekipe
  aktivna   Boolean  @default(true)
  barva     String   @default("#1d2b3e") // za prikaz v koledarju
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vodja     Profile?               @relation("CrewLeader", fields: [vodjaId], references: [id])
  members   Profile[]
  schedules InstallationSchedule[]
  installationRecords InstallationRecord[] // R378 §9 — as-installed zapisi ekipe (SetNull)

  @@index([aktivna])
}

model Equipment {
  id           String    @id @default(cuid())
  naziv        String    @unique // npr. "Laser Bosch GLM 50C", "Vijačnik", "Avtomobil A"
  tip          String // "MERSKA_OPREMA" | "ROČNO_ORODJE" | "PREVOZ" | "VARNOSTNA_OPREMA" | "OSTALO"
  sifra        String?
  status       String    @default("NA_VOLJO") // NA_VOLJO | V_UPORABI | V_SERVISU | IZGUBLJENO | UPOKOJENO (§31; CHECK v migraciji r145)
  lokacija     String? // npr. "Skladišče Kranj", "Avto A"
  zadnjiServis DateTime?
  opomba       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // R145 (§31 Equipment lifecycle): serijska številka, pridobitev, pregledi
  // in kalibracije. Kalibracija je POGOJ za mersko opremo (backfill:
  // tip='MERSKA_OPREMA' → calibrationRequired=true — deterministično, brez
  // ugibanja); rok (calibrationDueDate) + potrdilo vpisuje izvedeni pregled.
  serijskaStevilka       String? // §31 "serial number"
  pridobitev             DateTime? // §31 "acquisition"
  lastInspectionAt       DateTime? // zadnji PREGLED (iz EquipmentEvent)
  inspectionIntervalDays Int? // pogostost pregleda v dneh; null = brez periodike
  calibrationRequired    Boolean   @default(false) // merska oprema = true (fail-closed)
  calibrationDueDate     DateTime? // rok naslednje kalibracije (s potrdila)
  calibrationCertificate String? // §31 "certificate" — naziv/številka potrdila

  assignments EquipmentAssignment[]
  events      EquipmentEvent[]

  @@index([status])
}

// R145 (§31): zgodovina pregledov/kalibracij/servisov/Popravil opreme.
// Neomejen vpis je PRETEKLOST — ni stropov (revizija življenjskega cikla,
// podobno AuditLogu: pravno/tehnično pomembna sled se NE čišči).
model EquipmentEvent {
  id            String   @id @default(cuid())
  equipmentId   String
  type          String // PREGLED | KALIBRACJA | SERVIS | POPRAVILO
  performedAt   DateTime // kdaj je bilo izvedeno (nikoli v prihodnosti — 400)
  result        String   @default("V_REDU") // V_REDU | NAPAKA
  certificate   String? // potrdilo o kalibraciji (obvezno za KALIBRACIJO na merski opremi)
  opomba        String?
  performedById String?
  performedBy   Profile? @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, performedAt])
}

// Termin montaže v koledarju
model InstallationSchedule {
  id            String   @id @default(cuid())
  projectId     String
  crewId        String?
  monterId      String? // glavni monter (Profile.id)
  datumZacetka  DateTime
  datumKonca    DateTime
  status        String   @default("NAVRTENO") // NAVRTENO | V_TEKU | ZAKLJUCENO | PREKlicANO | PRELOZENO
  predvideneUre Int      @default(8)
  dejanskeUre   Int?
  opombe        String?
  lokacija      String? // naslov montaže
  gpsLat        Float?
  gpsLon        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project              Project                @relation(fields: [projectId], references: [id])
  crew                 Crew?                  @relation(fields: [crewId], references: [id])
  monter               Profile?               @relation("MonterSchedules", fields: [monterId], references: [id])
  equipment            EquipmentAssignment[]
  qualityControls      QualityControl[] // R146 §27 — preverbe kakovosti povezane s terminom
  installationEvidence InstallationEvidence[] // R147 §28 — montažna dokazila termina
  installationRecords  InstallationRecord[] // R378 §9 — as-installed zapisi termina (SetNull — termin umre, resnica ostane)

  @@index([datumZacetka])
  @@index([crewId])
  @@index([status])
}

// R146 (issue #5 §27 — Quality control gate): struktuirana preverba kakovosti
// pred zaključitvijo termina/prehodom projekta v MONTIRANO.
//
// Kontrolni seznam je DETERMINISTIČEN in živi v kodi (lib/qc-gate.ts,
// QC_TEMPLATE z verzijo) — vrstic NI v bazi, zato ni plesa sheme ob spremembi
// seznama; sprememba seznama = nova verzija (templateVersion), stare zapisi
// ostanejo berljivi z njihovo verzijo. itemsJson je strogo validiran
// (validateQCItems: natanko ključi predloge, boolean checked, opomba OBVEZNA
// pri neizpolnjeni postavki — napaka brez ukrepa se ne zapiše). Fail-closed
// vrata so v PATCH /api/schedules: ZAKLJUCENO brez PREŠLE preverbe zahteva
// izrecen qcOverrideReason (revizirano QC_OVERRIDE).
model QualityControl {
  id              String   @id @default(cuid())
  projectId       String
  scheduleId      String?
  templateVersion String
  itemsJson       String // JSON — oblika številka QC_TEMPLATE_VERSION
  passed          Boolean
  defectsCount    Int // število neizpolnjenih postavk (deterministično)
  note            String? // povzetek korektivnih ukrepov (opcijsko)
  approvedById    String?
  approvedBy      Profile? @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedule InstallationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  installationRecords InstallationRecord[] // R378 §9 — as-installed zapisi s to preverbo (SetNull)

  @@index([projectId, approvedAt])
  @@index([scheduleId])
}

// R147 (issue #5 §28) — Struktuirano montažno dokazilo: pred/po, lokacija,
// čas, akter, projekt, GPS (SAMO z izrecnim dovoljenjem — gpsConsentAt),
// checklist (verzirana predloga), merilni dokaz, poraba materiala (IZVEDENA
// s strežnika iz StockLedger — nikoli iz klienta), napake, dokaz predaje.
model InstallationEvidence {
  id              String    @id @default(cuid())
  projectId       String
  scheduleId      String?
  templateVersion String // "iev-v1" — sprememba seznama = nova verzija
  lokacija        String // kje je bila montaža (obvezno, ≤ 300 znakov)
  beforePhotoId   String?
  afterPhotoId    String?
  /// GPS po policyju: shranjeno IZKLJUČNO z izrecnim dovoljenjem terenskega
  /// uporabnika (gpsConsentAt = čas soglasja). Brez soglasja = null (ne tiho).
  gpsLat          Float?
  gpsLng          Float?
  gpsConsentAt    DateTime?
  /// JSON po obliki IEV_TEMPLATE_VERSION (isti fail-closed vzorec kot QC).
  checklistJson   String
  /// Merilni dokaz (povezana VERIFIED meritev istega projekta).
  measurementId   String?
  /// JSON lista napak: [{ opomba, reseno }] — strogo validirana (≤ 20).
  defectsJson     String
  /// Dokaz predaje: ime predaja + čas. Zakleni dokazilo (nič več ni spreminljivo).
  handoverName    String?
  handoverAt      DateTime?
  note            String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedule    InstallationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  beforePhoto ProjectPhoto?         @relation("EvidenceBeforePhoto", fields: [beforePhotoId], references: [id], onDelete: SetNull)
  afterPhoto  ProjectPhoto?         @relation("EvidenceAfterPhoto", fields: [afterPhotoId], references: [id], onDelete: SetNull)
  measurement Measurement?          @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  createdBy   Profile?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  installationRecords InstallationRecord[] // R378 §9 — as-installed zapisi s tem dokazilom (SetNull)

  @@index([projectId, createdAt])
  @@index([scheduleId])
}

// Oprema dodeljena terminu montaže
model EquipmentAssignment {
  id          String   @id @default(cuid())
  scheduleId  String
  equipmentId String
  datumOd     DateTime
  datumDo     DateTime
  opomba      String?
  createdAt   DateTime @default(now())

  schedule  InstallationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  equipment Equipment            @relation(fields: [equipmentId], references: [id])

  @@index([scheduleId])
  @@index([equipmentId])
}

// R148 (issue #5 §36 — Mobile sync conflict model): naprava (mobilni klient)
// v sync protokolu. deviceId generira klient (stabilen UUID), strežnik ga
// samo zabeleži (lenobni upsert ob vsaki sync zahtevi z X-Device-Id).
model SyncDevice {
  id             String   @id @default(cuid())
  deviceId       String   @unique
  name           String?
  /// ApiKey, ki je napravo uvedel (SetNull — ključ se lahko izbriše).
  apiKeyId       String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  /// Nazadnje videna revizija (lenobni zapis ob GET ?sinceRevision=…).
  lastSyncCursor Int      @default(0)

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
}

// R148 (§36) — grobnica: mobilni projekt je IZBRISAN iz sync zrcala
// (DELETE /api/sync). Preživi brisanje projekta (projectId SetNull —
// ni cascade!), zato ponovni sync istega mobileProjectId NE ustvari
// dvojnika, ampak dobi iskren 409-style rezultat "tombstone".
model SyncTombstone {
  id              String   @id @default(cuid())
  mobileProjectId String   @unique
  reason          String
  tombstonedAt    DateTime @default(now())
  createdById     String?
  /// Projekt, če je vrstica še živa (SetNull — grobnica preživi brisanje).
  projectId       String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy Profile? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tombstonedAt])
}

// ============================================
// API KLJUCI (mobilni klient: BalkonAR)
// ============================================
//
// Prej je /api/sync "avtenticiral" s preverjanjem predpone
// `key.startsWith('ROKSAL_MOBILE_') && key.length >= 20` — oblika je bila v javnem
// repu, torej je bil vsak, ki jo je poznal, pooblaščen za pisanje v bazo.
// Zdaj se hrani samo SHA-256 ključa, ključ je viden enkrat ob ustvarjanju,
// posamezen ključ pa je mogoče preklicati brez menjave ostalih.
model ApiKey {
  id         String    @id @default(cuid())
  /// Človeško berljivo ime ("Marko - telefon", "BalkonAR test").
  name       String
  keyHash    String    @unique
  /// Prvih 12 znakov za prepoznavo v seznamu (brez razkritja ključa).
  keyPrefix  String
  createdBy  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  // ── R126 — issue #5 §3: API-key lifecycle ────────────────────────────────
  /// Namenska raba ključa ("BalkonAR mobilni klient terenske ekipe").
  purpose         String?
  /// Scope lista (R126 §3), ločena z vejico. Privzeto dobrodelni nabor
  /// MOBILE_SYNC iz matrike v src/lib/access.ts. Katalog: src/lib/api-keys.ts.
  scopes          String    @default("projects:read,projects:write,measurements:create,photos:read,photos:write")
  /// Omejitev na projekte (ID-ji ločeni z vejico). Null/prazno = vsi projekti
  /// (sync zrcalo podjetja — dosedanja pogodba MOBILE_SYNC).
  projectScope    String?
  /// Ko ključ poteče, ga verifyApiKey zavrne (fail-closed). Null = ne poteče.
  expiresAt       DateTime?
  /// ID predhodnika, če je ključ nastal z rotacijo (--rotate).
  rotatedFrom     String?
  /// Per-key omejitev hitrosti (zahtevkov/minuto). Null = privzeto 120.
  rateLimitPerMin Int?

  /// R148 (§36) — naprave, ki jih je ključ uvedel v sync protokol.
  syncDevices SyncDevice[]
}

// ============================================
// PREJEMNI ZAPISNIK (punch list / closeout)
// ============================================
// Kontrolni seznam pred predajo projekta naročniku:
// meja/soglasja, montaža, čiščenje, predaja dokumentacije.
model PunchItem {
  id        String   @id @default(cuid())
  projectId String
  naslov    String
  opomba    String?
  status    String   @default("open") // open | done | issue
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// RAČUNI (FURS layer — predračun / račun / predplačilni račun)
// ============================================
// Slovenski zakonski obvezni podatki računa (ZDDV-1, 37. člen):
// zaporedna številka, datum izdaje, podatek o prostoru/napravi,
// izdajatelj (davčna št.), naročnik, postavke, DDV 22 %, rok plačila.
// Postavke in kupec so JSON snapshot — račun se ne spreminja, če se
// kasneje spremenita projekt ali BOM (račun je pravnok act dokument).
model Invoice {
  id            String    @id @default(cuid())
  projectId     String
  tip           String    @default("RACUN") // PREDRACUN | RACUN | PREDPLACILNI
  /// Zaporedna številka oblike "2026-001" (per leto, enota: Roksal d.o.o.)
  stevilka      String    @unique
  datumIzdaje   DateTime  @default(now())
  datumStoritve DateTime?
  rokPlacilaDni Int       @default(8)
  status        String    @default("OSNUTEK") // OSNUTEK | IZDAN | PLACAN | STORNIRAN
  placanoAt     DateTime?
  /// Postavke JSON: [{opis, kolicina, enota, cenaNaEnoto, ddvStopnja}]
  postavke      String
  /// Snapshot kupca ob izdaji: {ime, naslov, telefon?, email?, davcnaSt?}
  kupec         String?
  /// Skupaj brez DDV (EUR)
  osnova        Decimal  @default(0) @db.Decimal(12, 2)
  /// DDV 22 % (EUR)
  ddv           Decimal  @default(0) @db.Decimal(12, 2)
  /// Za plačilo (EUR)
  znesek        Decimal  @default(0) @db.Decimal(12, 2)
  opombe        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  /// R136 (§18): dashboard/pregled filtrira "projekt + status" — kompozitni
  /// indeks pade iz dveh posameznih na en range scan.
  @@index([projectId, status])
}

// ============================================
// 20. TERENSKI PREGLED — zapisnik monterja pred montažo (runda Q)
// En zapisnik na projekt (upsert): kaj monterja čaka na objektu + pametni
// seznam "s seboj prinesti" (orodje/mozniki) glede na podlago, pritrditev, ovire.
// ============================================
model SiteSurvey {
  id                String   @id @default(cuid())
  projectId         String   @unique
  tipObjekta        String   @default("balkon") // balkon|stopnice|terasa|loggia|friz|prehod
  oblika            String   @default("ravno") // ravno|L|U|krog
  pritrditev        String   @default("obrobna") // obrobna|tloris|stena|mesano
  podlaga           String   @default("neznan") // beton|estrih|les|kovina|plocice|neznan
  razponNajdaljsiMm Int?
  skupnaDolzinaMm   Int?
  visinaMm          Int?
  steviloStopnic    Int?
  razhodMm          Int?
  /// CSV ovir: cevi|vticnice|podstavki|osvetlitev|okna|locnik|vlaga|druge
  ovire             String?
  dvigalo           Boolean  @default(false)
  dostopOpomba      String?
  /// CSV posnetih točk foto kontrolnega seznama: tip1|meritve|podlaga|pritrditev|ovire|celota
  fotoPosneto       String?
  /// RAL barva prahu izbrana na terenu (runda R): 7016|9005|9016|6005|8017
  ralCode           String?
  opombe            String?
  zakljuceno        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([zakljuceno])
}

// ============================================
// 21. VIZ (Vizualizacija ograje) — runda S+2
// Spec: docs/VIZ_CONTRACTS.md (single source of truth)
// Datoteke na disku: public/viz/projects/<id>/ (original.jpg, product.jpg,
// product-mask.png, mask.png, placement.json, preview.jpg, result.json)
// — gitignore-ane runtime mape; poti v bazi so javni URL-ji (/viz/projects/...).
// placement in variants sta JSON string (SQLite nima JSON tipa).
// ============================================

model VizProject {
  id              String         @id @default(cuid())
  // S+4 lastništvo: Profile.id seje, ki je projekt ustvarila. Null = zapuščina
  // iz rund pred S+4 (vidijo jo samo ADMIN — glej docs/VIZ_CONTRACTS.md).
  ownerId         String?
  name            String
  originalPath    String
  productPath     String
  productMaskPath String?
  maskPath        String
  previewPath     String?
  resultPath      String?
  resultImagePath String?
  placement       String
  variants        String?
  idempotencyKey  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  renderJobs      VizRenderJob[]

  @@index([ownerId])
}

// GPU render job (Qwen-Image-Edit-2509) — R319 (S+7): končni status 'completed'
// nastavimo SAMO na dokaz GPU strežnika (poll-on-read v GET ruti prenese PNG
// v shrambo); nikoli lažno. Statusi: queued | processing | completed | failed
model VizRenderJob {
  id         String     @id @default(cuid())
  // S+4: lastnik joba = seja, ki je job ustvarila (null = zapuščina, ADMIN only).
  ownerId    String?
  projectId  String
  project    VizProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     String     @default("queued")
  engine     String     @default("qwen-image-edit-2509")
  inputJson  String
  // R319 (S+7): jobId NA GPU strežniku (odgovor POST /render). Null = job
  // brez GPU integracije (zgodovina / VIZ_GPU_URL unset) — status takih
  // jobov NE regresira (državni stroj v repository.ts je nespremenjen).
  gpuJobId   String?
  resultPath String?
  error      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([projectId])
  @@index([status])
}

// ============================================
// IDEMPOTENCA (R128 — issue #5 §4: offline vrsta)
// ============================================
// Terenski klient pošilja čakajoče zapise s stabilnim `Idempotency-Key`
// (klient mutacijski ID). Strežnik shrani snapshot odgovora — ponovitev
// istega ključa vrne ORIGINALNI odgovor in ne ustvari dvojnika (npr. dve
// meritvi iz istega offline zapisa po več poizkusih pošiljanja).
// Ključ je vezan na profil (profileId) — tuj ključ ne razkrije odgovora.
model IdempotencyKey {
  key            String   @id
  /// Katera raba (route family): "measurements" | "ar-snapshots" …
  route          String
  /// Lastnik ključa (avtorizacija replaya) — null = rezervacija brez seje.
  profileId      String?
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

/// R132 (issue #5 §7): dostopni dnevnik javnega portala stranke.
/// Vsak poskus (uspešen ali ne) se zabeleži — revizija javne površine.
/// ipHash = sha256(IP + API_KEY_PEPPER), 32 hex znakov — zasebnost obiskovalcev.
model PortalAccess {
  id        String   @id @default(cuid())
  /// null = poskus z neobstoječim žetonom (nismo podigli projekt).
  projectId String?
  /// OK | NOT_FOUND | DISABLED | EXPIRED | REVOKED | RATE_LIMITED | INVALID
  status    String
  ipHash    String
  userAgent String?
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
}

/// R141 (issue #5 §23 — Background jobs): enoten register poslov (job ledger).
///
/// Vsak zagon vzdrževalnega posla (GC idempotenčnih ključev, GC dostopov
/// portala, GC starih sej …) ima VRSTICO z vsemi zahtevami §23:
///   • job ID          = `id` (cuid) — povezljiv z logi prek correlationId;
///   • owner           = kdo je sprožil: "cron" (Vercel Cron) ali e-mail
///                       ADMIN-a pri ročnem zagonu prek UI;
///   • input           = JSON parametri zagona (okno, pragovi);
///   • status          = RUNNING | SUCCEEDED | FAILED;
///   • attempts        = števec poskusov znotraj istega okna (okno = dan);
///   • retry policy    = maxAttempts + dokumentirana naravna ponovitev
///                       (dnevni cron poskusi naslednji dan znova);
///   • error           = lastError (sanitiziran prek correlationErrorSummary —
///                       brez stacka, brez Prisma internals, §22 pogodba);
///   • idempotency     = idempotencyKey (type + okno) UNIQUE — dvakrat isti
///                       dan = replay (drugi zagon NE dela dvojno delo);
///   • correlation ID  = nosilec povezave z Vercel logi istega zagona.
model JobRun {
  id             String    @id @default(cuid())
  type           String
  owner          String
  input          String?
  status         String
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  correlationId  String
  idempotencyKey String    @unique
  result         String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?

  @@index([type, createdAt])
  @@index([createdAt])
}

// ============================================
// 24. R373 — KANONIČNA POSLOVNA RESNICA PONUDB (issue #13 korak R165)
// PriceBookVersion/PriceBookItem + Quote/QuoteVersion: strežniško avtoritativni
// cenik in NESPREMENLJIVE (immutable) verzije ponudb.Deal-lock se od R373
// veže EXKLUZIVNO na QuoteVersion (§2/§3/§4/§7/§8/§16/§17).
// ============================================

/// R373 (§4): strežniško avtoritativna verzija cenika. Statusni stroj
/// DRAFT → ACTIVE → RETIRED (en vir: src/lib/price-book-store.ts). Aktivacija
/// nove verzije TRANSAKCIJSKO upokoji prejšnjo ACTIVE — DVE hkrati je pokvarjeno
/// stanje in se JAVNO odkloni (nikoli "izberi novejšo").
model PriceBookVersion {
  id            String    @id @default(cuid())
  /// Zaporedna številka verzije cenika (1 = seed iz defaultPriceBook).
  version       Int       @unique
  /// DRAFT | ACTIVE | RETIRED (CHECK v migraciji; statusni stroj v lib).
  status        String
  currency      String    @default("EUR")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdById   String?
  approvedById  String?
  createdAt     DateTime  @default(now())
  approvedAt    DateTime?

  items  PriceBookItem[]
  quoteVersions QuoteVersion[] // R373 §3 — verzije, vezane na to verzijo cenika
  bomVersions   BOMVersion[]  // R376 §6 — BOM verzije, vezane na to verzijo cenika

  @@index([status])
  @@index([createdAt])
}

/// R373 (§4): posamezna postavka cenika. `key` = numerični ključ iz
/// PriceBook (defaultPriceBook — src/lib/quote.ts; whitelist fail-closed).
/// referenceCost NULL = lastnik še NI VNESel realne nabavne cene → načrtovana
/// marža je iskreno NEZNANA (§8: nikoli izmišljeni odstotki).
model PriceBookItem {
  id                 String   @id @default(cuid())
  priceBookVersionId String
  /// Numerični ključ PriceBook (npr. "glassPerM2", "vatPercent").
  key                String
  label              String
  unit               String
  /// Kategorija BOM skupine (GLASS/PROFILES/POSTS/INFILL/FIXINGS/LABOUR/OTHER).
  category           String
  salesPrice         Decimal  @db.Decimal(12, 2) // CHECK >= 0 v migraciji
  /// NULL = NEZNANO (iskrena marža; §8) — nikoli placeholder 0.6/0.15.
  referenceCost      Decimal? @db.Decimal(12, 2)

  priceBookVersion PriceBookVersion @relation(fields: [priceBookVersionId], references: [id], onDelete: Cascade)

  @@unique([priceBookVersionId, key])
  @@index([priceBookVersionId])
}

/// R373 (§3): ponudba projekta — nosilec zaporednih verzij.
model Quote {
  id               String    @id @default(cuid())
  projectId        String
  customerId       String?
  /// ŽIVLJENJSKI CIKL ponudbe (vedno odprt — verzije so tiste z življenjskim ciklom).
  status           String    @default("ODPRTA")
  /// Kazalnik na trenutno (zadnjo) verzijo — skalarne reference (brez FK
  /// cikla Quote→QuoteVersion→Quote); resnico o verzijah nosi QuoteVersion.
  currentVersionId String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  versions QuoteVersion[]

  @@index([projectId])
}

/// R373 (§3): NESPREMENLJIVA verzija ponudbe. Po ISSUED/APPROVED se NE spreminja
/// (sprememba = nova verzija; statusni stroj DRAFT→ISSUED→APPROVED,
/// DRAFT→REJECTED, supersede ob novi verziji — src/lib/quote-versions.ts).
/// inputsJson = točno vhodi izračuna (points/closed/overridesMm/spec override),
/// linesJson = postavke (QuoteItem[] z sourceKey), seštevki subtotal/vat/total
/// pa so VEZANI na priceBookVersionId + inputHash (verifyQuoteVersionIntegrity).
model QuoteVersion {
  id                String   @id @default(cuid())
  quoteId           String
  versionNumber     Int
  /// DRAFT | ISSUED | APPROVED | REJECTED | SUPERSEDED (CHECK v migraciji).
  status            String
  /// VHODI izračuna (surovi, ne zliti) — rekonstrukcija iz njih + VEZANE knjige.
  inputsJson        Json
  /// Postavke QuoteItem[] (vključno sourceKey za maržo).
  linesJson         Json
  subtotal          Decimal  @db.Decimal(12, 2) // CHECK >= 0
  vat               Decimal  @db.Decimal(12, 2) // CHECK >= 0
  total             Decimal  @db.Decimal(12, 2) // CHECK >= 0
  currency          String   @default("EUR")
  /// Prstni odtis učinkovitih vhodov (quoteInputFingerprint, quote-v1).
  inputHash         String
  /// VEZANA verzija cenika — integriteta se preverja PROTI NJOJ (§4).
  priceBookVersionId String
  createdById       String?
  approvedById      String?
  createdAt         DateTime @default(now())
  approvedAt        DateTime?

  quote           Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  priceBookVersion PriceBookVersion @relation(fields: [priceBookVersionId], references: [id])

  sourceBomVersions BOMVersion[] @relation("BomSourceQuoteVersions") // R376 §6 — BOM verzije, izpeljane iz te verzije ponudbe

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@index([priceBookVersionId])
  @@index([status])
}

// ============================================
// 25. R376 — KANONIČNI BOM (issue #13 korak R166, §5/§6/§11 + §7 vezava)
// BOM/BOMVersion/BOMLine: strukturiran kosovnik nad NESPREMENLJIVIMI
// verzijami; Project.bomDraftJson ostane SAMO kot legacy/read-model
// (NIČ več kanonski vir — deal-lock ga še vedno piše za stari UI).
// ============================================

/// R376 (§6): nosilec BOM projekta — EN vrstica na projekt (projectId UNIQUE:
/// življenjski cikel nosijo VERZIJE, drugi "nosilec" za isti projekt nima
/// poslovnega pomena; DB zagotavlja enojnost brez delnega indeksa). Status
/// nosilca: AKTIVEN (privzeto) | ZAPRT (rezervirano za zaključek projekta —
/// v tej rundi ŠE BREZ prehoda, iskreno dokumentirano, ne izmišljeno).
model BOM {
  id        String   @id @default(cuid())
  projectId String   @unique
  status    String   @default("AKTIVEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions BOMVersion[]

  @@index([status])
}

/// R376 (§6): NESPREMENLJIVA verzija BOM. Po APPROVED se NE spreminja
/// (sprememba = nova verzija, ki prejšnjo postavi v SUPERSEDED; statusni
/// stroj v src/lib/bom-versions.ts — EN VIR). Vsaka verzija hrani sled
/// izvora: sourceQuoteVersionId (kanonična ponudba), priceBookVersionId
/// (vezana knjiga — vir stroškovnih referenc), productSdkVersion (snapshot
/// verzije izračuna, npr. 'quote-v1') in layoutFingerprint (= inputHash
/// izvorne verzije ponudbe — geometrijska/izračunska sledljivost, §5).
model BOMVersion {
  id                   String    @id @default(cuid())
  bomId                String
  versionNumber        Int
  /// DRAFT | APPROVED | SUPERSEDED (CHECK v migraciji; matrika v lib).
  status               String
  /// Kanonična QuoteVersion, iz katere je BOM izpeljan (§6 sled izvora).
  sourceQuoteVersionId String
  /// Vezana verzija cenika (PREPISAN iz izvorne QuoteVersion — isti vir stroškov).
  priceBookVersionId   String
  /// Snapshot verzije izračuna (QUOTE_FORMULA_VERSION — sol odtisa 'quote-v1').
  productSdkVersion    String
  /// Odtis geometrije/izračuna = sourceQuoteVersion.inputHash (§5 sledljivost).
  layoutFingerprint    String
  createdById          String?
  approvedById          String?
  createdAt            DateTime  @default(now())
  approvedAt           DateTime?

  bom               BOM              @relation(fields: [bomId], references: [id], onDelete: Cascade)
  sourceQuoteVersion QuoteVersion     @relation("BomSourceQuoteVersions", fields: [sourceQuoteVersionId], references: [id], onDelete: Cascade)
  priceBookVersion   PriceBookVersion @relation(fields: [priceBookVersionId], references: [id])
  lines              BOMLine[]
  productionOrders   ProductionOrder[]    @relation("ProductionOrderBomVersions") // R378 §10 — nalogi nad TO verzijo (RESTRICT)
  installationRecords InstallationRecord[] @relation("InstallationRecordBomVersions") // R378 §9 — as-installed proti TO verziji (RESTRICT)

  @@unique([bomId, versionNumber])
  @@index([bomId])
  @@index([sourceQuoteVersionId])
  @@index([priceBookVersionId])
  @@index([status])
  @@index([createdAt])
}

/// R376 (§5): ENA vrstica na materialno postavko BOM verzije. internalSku =
/// QuoteItem.code (strukturiran identifikator — NIKOLI tekstovna hevristika
/// 'vsebuje wpc'); inventoryId se VEŽE SAMO prek EXACT ujemanja
/// Inventory.sifraMateriala === internalSku (brez fuzzy, brez includes) —
/// neujemana postavka ostane NEVEZANA (NULL + javni razlog v procurement
/// pogledu, §11). Honest NULLs (§8): wasteFactor/grossQuantity/unitCost/
/// totalCost so NULL, dokler vir resnice ne obstaja — NIKOLI izmišljeni
/// odstotki/količine/cene.
model BOMLine {
  id             String   @id @default(cuid())
  bomVersionId   String
  /// Zaporedna številka vrstice znotraj verzije (determinizem — vrstni red).
  lineOrder      Int
  /// Ključ postavke ponudbe (QuoteItem.sourceKey ?? code) — direktna sled.
  quoteLineKey   String?
  /// Kanonični interni SKU = QuoteItem.code (EN VIR identitete postavke).
  internalSku    String
  /// Dobaviteljeva šifra — v bazi ŠE ni vira (iskreno NULL; §8).
  supplierSku    String?
  /// EXACT vezava na Inventory (sifraMateriala === internalSku) ali NULL.
  inventoryId    String?
  /// Kategorija BomGroup (GLASS/PROFILES/POSTS/INFILL/FIXINGS/LABOUR/OTHER — CHECK).
  category       String
  /// Zmrznjen opis: `${name} — ${detail}` izvirne postavke ponudbe.
  descriptionSnapshot String
  /// NETO količina = QuoteItem.qty (iz LayoutResult — NE ocena iz EUR; CHECK > 0).
  quantity       Decimal  @db.Decimal(12, 3)
  unit           String
  /// Odpadek — NEZNAN brez vira (NULL; §8). Nikoli izmišljen odstotek.
  wasteFactor    Decimal? @db.Decimal(6, 4)
  /// Bruto količina — izpeljiva ŠELE, ko je wasteFactor znan (NULL; §8).
  grossQuantity  Decimal? @db.Decimal(12, 3)
  /// Nabavna referenca iz VEZANE knjige (PriceBookItem.referenceCost prek
  /// sourceKey) — NULL = iskreno NEZNANO (§8, nikoli 0.6-hevistika).
  unitCost       Decimal? @db.Decimal(12, 2)
  /// unitCost × quantity, SAMO kadar je unitCost znan (sicer NULL).
  totalCost      Decimal? @db.Decimal(12, 2)
  /// Dobavitelj iz EXACT inventarne vezave (zadnja MaterialPrice) ali NULL.
  supplierId     String?
  /// Besedilni snapshot sledi: quoteLineKey + layoutFingerprint reference.
  geometrySource String?
  /// Verzija izračunskega pravila (QUOTE_FORMULA_VERSION — 'quote-v1').
  calculationRuleVersion String
  /// AKTIVEN (privzeto) | PREKINJAN (rezervirano za change-order — v tej rundi
  /// ŠE BREZ prehoda, iskreno; CHECK v migraciji).
  status         String

  bomVersion BOMVersion @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  inventory  Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  productionOrderLines  ProductionOrderLine[]  // R378 §10 — proizvodne vrstice nad to BOM vrstico (RESTRICT)
  installationRecordLines InstallationRecordLine[] // R378 §9 — vgrajene vrstice vezane na to BOM vrstico (RESTRICT)

  @@index([bomVersionId])
  @@index([inventoryId])
  @@index([supplierId])
  @@index([internalSku])
}

// ============================================
// 26. R378 — PRODUKCIJA (§10) + AS-INSTALLED (§9) — issue #13 korak R167
// Količinska veriga QUOTE → BOM → PRODUCTION → INSTALLATION z variancami:
// ProductionOrder/Line/Operation nad ODOBRENIM BOM (NIKOLI rekanalc
// geometrije — snapshoti BOMLine so VHOD) + InstallationRecord/Line kot
// TRETJA RESNICA (verzionirano, POTRJENO terminalno).
// ============================================

/// R378 (§10): proizvodni nalog nad ODOBRENIM BOM. Statusni stroj (EN VIR
/// v src/lib/production-orders.ts): PLANNED→RELEASED→IN_PRODUCTION→QC→
/// PRODUCED→READY_FOR_INSTALLATION + izidi REWORK/REJECTED/SCRAPPED/REPLACED
/// (REJECTED/SCRAPPED/REPLACED terminalni). Priority NIZKA|NORMALNA|URGENTNO.
/// approvedById/approvedAt se napolnita ob prehodu PLANNED→RELEASED
/// (izpust v proizvodnjo = odobritev izvedbe — dokumentirana odločitev).
model ProductionOrder {
  id           String    @id @default(cuid())
  projectId    String
  /// FK RESTRICT: odobren BOM je vir resnice naročila (§10 — nikoli sprostitev).
  bomVersionId String
  /// PLANNED | RELEASED | IN_PRODUCTION | QC | PRODUCED | READY_FOR_INSTALLATION | REWORK | REJECTED | SCRAPPED | REPLACED (CHECK v migraciji).
  status       String    @default("PLANNED")
  /// NIZKA | NORMALNA | URGENTNO (CHECK v migraciji).
  priority     String    @default("NORMALNA")
  /// Rok izdelave — NEZNAN brez vnosa (NULL; §8).
  dueAt        DateTime?
  /// Mehka revizijska referenca na Profile (isti vzorec kot R374/R376 — brez FK).
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bomVersion BOMVersion            @relation("ProductionOrderBomVersions", fields: [bomVersionId], references: [id], onDelete: Restrict)
  lines      ProductionOrderLine[]
  operations ProductionOperation[]
  installationRecords InstallationRecord[] @relation("InstallationRecordProductionOrders")

  @@index([projectId])
  @@index([bomVersionId])
  @@index([status])
  @@index([createdAt])
}

/// R378 (§10): proizvodna vrstica = SNAPSHOT BOMLine (sledljivost: internalSku
/// se ne poizveduje živo — verzija BOM je nespremenljiva, snapshot je resnica
/// trenutka izpeljave). plannedQty = BOMLine.quantity ob ustvarjanju (iskren
/// snapshot, ne živa referenca). remainingQty strežniško izračunano
/// (planned − produced − scrapped) — NIKOLI klientovo total.
model ProductionOrderLine {
  id                String  @id @default(cuid())
  productionOrderId String
  /// FK RESTRICT: vrstica ne sme preživeti svoje BOM vrstice (sled resnice).
  bomLineId         String
  /// Zaporedna številka vrstice znotraj naročila (determinizem — vrstni red).
  lineOrder         Int
  /// Snapshot internalSku iz BOMLine (sledljivost — EN VIR ob izpeljavi).
  internalSku       String
  /// Načrtovana količina = BOMLine.quantity ob ustvarjanju (CHECK > 0).
  plannedQty        Decimal @db.Decimal(12, 3)
  /// Uspešno izdelano (CHECK ≥ 0; privzeto 0 — nič ni laž, je dejstvo).
  producedQty       Decimal @db.Decimal(12, 3) @default(0)
  /// Zavrnjeno ob kontroli (CHECK ≥ 0; rejected ≤ produced — invariant plasti).
  rejectedQty       Decimal @db.Decimal(12, 3) @default(0)
  /// Odpisano (CHECK ≥ 0; produced + scrapped ≤ planned — invariant plasti).
  scrappedQty       Decimal @db.Decimal(12, 3) @default(0)
  /// STREŽNIŠKO izračunano: planned − produced − scrapped (CHECK ≥ 0) —
  /// klient NIKOLI ne pošilja tega polja (forged vhod se zavrne).
  remainingQty      Decimal @db.Decimal(12, 3)
  unit              String

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  bomLine         BOMLine         @relation(fields: [bomLineId], references: [id], onDelete: Restrict)

  @@unique([productionOrderId, bomLineId])
  @@index([bomLineId])
}

/// R378 (§10): proizvodna operacija (rezanje/bušenje/obdelava/pakiranje …).
/// operationType je PROST niz ≤ 100 — izumljeni enum bi bil izum (§8);
/// status PLANNED|IN_PROGRESS|DONE|FAILED (CHECK; matrika v lib). Trajanja v
/// minutah (Int — hišni kanon); NULL = iskreno NEZNANO (§8).
model ProductionOperation {
  id                 String    @id @default(cuid())
  productionOrderId  String
  /// Prosti tip operacije (rezanje/bušenje/obdelava/pakiranje…) ≤ 100 znakov.
  operationType      String
  /// Zaporedje operacij znotraj naročila (CHECK > 0).
  sequence           Int
  /// Načrtovano trajanje v minutah — NULL = neznano (§8).
  plannedDurationMin Int?
  /// Dejansko trajanje v minutah — NULL = še ni zabeleženo (§8).
  actualDurationMin  Int?
  /// Izvajalec (Profile) — NULL = nezabeležen (SetNull preživi brisanje računa).
  operatorId         String?
  /// PLANNED | IN_PROGRESS | DONE | FAILED (CHECK v migraciji; matrika v lib).
  status             String    @default("PLANNED")
  /// Opomba o izidu operacije (npr. vzrok FAILED) — izrecen, ne obvezen.
  result             String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  operator        Profile?       @relation("ProductionOperationOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([productionOrderId])
  @@index([operatorId])
}

/// R378 (§9): AS-INSTALLED — TRETJA RESNICA (kaj je DEJANSKO vgrajeno),
/// verzionirana (revizija = NOVA verzija, nikoli tiha mutacija — isti kanon
/// kot QuoteVersion R374 / BOMVersion R376). DRAFT → POTRJENO (terminalno).
/// Prek qcId/evidenceId VEZAVA na obstoječa QualityControl/InstallationEvidence
/// (PONOVNA UPORABA — fotografije/checkboxi NE duplirajo). productionOrderId
/// SET NULL: zapis as-installed je TRAJNEJŠI od naročila — montaža se je
/// FIZIČNO zgodila in ne umre z brisanjem naročila.
model InstallationRecord {
  id                  String    @id @default(cuid())
  projectId           String
  /// Vezava na obstoječi termin montaže (SetNull — termin umre, resnica ostane).
  scheduleId          String?
  /// Vgrajeno proizvodno naročilo (SetNull — zapis preživi brisanje naročila).
  productionOrderId   String?
  crewId              String?
  monterId            String?
  /// FK RESTRICT: BOM resnica, proti kateri je zapis vgrajen (§9 veriga).
  bomVersionId        String
  /// Pričetek/konec dela — NULL = nezabeležen (§8, nikoli izmišljen trenutek).
  startedAt           DateTime?
  completedAt         DateTime?
  /// Zaporedna verzija zapisa (revizija = nova verzija; @@unique projectId+versionNumber).
  versionNumber       Int
  /// DRAFT | POTRJENO (CHECK v migraciji; POTRJENO terminalno — §9).
  status              String    @default("DRAFT")
  /// JSON lista napak [{opomba, reseno}] — isti fail-closed vzorec kot
  /// InstallationEvidence.defectsJson (≤ 20; privzeto '[]').
  defectsJson         String    @default("[]")
  /// Opomba o popravilu (rework) — izrecen, ne obvezen.
  reworkNote          String?
  /// §9 QC referenca (PONOVNA UPORABA QualityControl — brez duplikacije).
  qcId                String?
  /// §9 pred/po dokazila (PONOVNA UPORABA InstallationEvidence — brez duplikacije fotografij).
  evidenceId          String?
  /// Dokaz predaje — nastavljiv OB potrditvi (POTRJENO zaklene zapis).
  handoverName        String?
  handoverAt          DateTime?
  /// JSON dejanskih mer (snapshot) — NULL = brez mer (iskreno, §8).
  actualMeasurementsJson String?
  /// Mehka revizijska referenca na Profile (isti vzorec kot R374/R376 — brez FK).
  createdById         String?
  approvedById        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  approvedAt          DateTime?

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedule         InstallationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  productionOrder  ProductionOrder?     @relation("InstallationRecordProductionOrders", fields: [productionOrderId], references: [id], onDelete: SetNull)
  crew             Crew?                @relation(fields: [crewId], references: [id], onDelete: SetNull)
  monter           Profile?             @relation("InstallationRecordMonter", fields: [monterId], references: [id], onDelete: SetNull)
  bomVersion       BOMVersion           @relation("InstallationRecordBomVersions", fields: [bomVersionId], references: [id], onDelete: Restrict)
  qc               QualityControl?      @relation(fields: [qcId], references: [id], onDelete: SetNull)
  evidence         InstallationEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  lines            InstallationRecordLine[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@index([bomVersionId])
  @@index([scheduleId])
  @@index([productionOrderId])
  @@index([status])
}

/// R378 (§9): vgrajena vrstica as-installed. bomLineId NULL = vgrajen
/// material IZVEN BOM (iskreno — neizvirščan material se NE tiho pripne na
/// BOM vrstico). wasteQty NULL = neznano (§8 — nikoli izmišljen).
model InstallationRecordLine {
  id                   String   @id @default(cuid())
  installationRecordId String
  /// NULL = vgrajen material IZVEN BOM (iskreno; RESTRICT sicer — sled ne laže).
  bomLineId            String?
  /// Snapshot SKU (pri bomLineId ≠ NULL prekopiran iz BOMLine, sicer ročni vnos).
  internalSku          String
  /// Dejansko vgrajena količina (CHECK > 0 — 0 bi bila laž 'vgrajeno nič').
  installedQty         Decimal  @db.Decimal(12, 3)
  unit                 String
  /// Odpadek pri vgradnji — NULL = nezabeležen (§8; CHECK ≥ 0 kadar prisoten).
  wasteQty             Decimal? @db.Decimal(12, 3)
  note                 String?

  installationRecord InstallationRecord @relation(fields: [installationRecordId], references: [id], onDelete: Cascade)
  bomLine            BOMLine?           @relation(fields: [bomLineId], references: [id], onDelete: Restrict)

  @@index([installationRecordId])
  @@index([bomLineId])
}

// ============================================
// 45. R390 (issue #13, korak R170 iz §14) — PRODUKTNI KATALOG:
//     APLIKACIJSKI KONTEKST (Family → Product → Variant →
//     Application → Compatibility → Fixing/Accessory)
// ============================================

/// R390 (§14): verzija kataloga — isti statusni stroj kot PriceBookVersion
/// R373/R374 (DRAFT → ACTIVE → RETIRED; aktivacija TRANSAKCIJSKO upokoji
/// prejšnjo ACTIVE — dve ACTIVE hkrati = pokvarjeno stanje). Veljavnostni
/// intervali so §14 "effective dates" na nivoju verzije kataloga.
model ProductCatalogVersion {
  id           String    @id @default(cuid())
  /// Zaporedna številka verzije kataloga (1 = seed iz data/roksal-catalog.json).
  verzija      Int       @unique
  /// DRAFT | ACTIVE | RETIRED (CHECK v migraciji; stroj v catalog-store).
  status       String
  veljavnostOd DateTime
  /// NULL = velja do preklica (odprt interval — §8 NE izmišljamo konca).
  veljavnostDo DateTime?
  opomba       String?
  /// Mehka revizijska referenca na Profile (vzorec R374/R378 — brez FK).
  createdById  String?
  approvedById String?
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?

  products Product[]

  @@index([status])
  @@index([createdAt])
}

/// R390 (§14): ProductFamily — vrh hierarhije kataloga (npr. WoodCore).
/// Barvna paleta + splošna pravila montaže živijo TU (družinska resnica),
/// NE v posameznih UI-jih (§14: "ne hardcodirati teh pravil v več UI-jih").
model ProductFamily {
  id                 String   @id @default(cuid())
  /// EXACT kanonska šifra družine (npr. 'woodcore') — kanon §5 brez fuzzy.
  sifra              String   @unique
  naziv              String
  material           String
  garancija          String?
  uradnaStran        String?
  /// JSON barvne palete [{id,name,nameSl,approxHex|null,evidence}] — zod v catalog-domain.
  barvnaPaletaJson   String
  /// JSON splošnih pravil montaže (string[]) — §14 katalog nadomešča hardcode.
  splosnaPravilaJson String
  /// pending | granted | rejected (CHECK) — pariteta SDK RightsStatus.
  pravice            String
  aktivna            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products    Product[]
  accessories ProductAccessory[]
}

/// R390 (§14): Product — profil v aplikacijskem kontekstu. Dimenzije/
/// orientacijska pravila vijačenja/razmaki so PODATEK vrstice (EXACT iz
/// data/roksal-catalog.json — seed r390), NE logika UI-ja.
model Product {
  id                       String   @id @default(cuid())
  familyId                 String
  catalogVersionId         String
  /// EXACT kanonski id iz kataloga (npr. 'woodcore-romb-67') — kanon §5.
  sifra                    String   @unique
  naziv                    String
  /// precna | pokoncna | precna+pokoncna (CHECK).
  kategorija               String
  faceWidthMm              Int
  thicknessMm              Decimal  @db.Decimal(8, 2)
  /// JSON tovarniških dolžin [5800, ...] (primitivni tip ne sme biti lista).
  standardLengthsJson      String
  fixingMetoda             String
  /// §14 "screw constraints" — vidnost vijakov je PODATEK kataloga.
  screwsVisible            Boolean
  /// §14 "internal reinforcement" — alu cev v sredini profila (dokumentirana).
  interniOkrepitev         Boolean  @default(false)
  /// Citat vira okrepitve — NULL = ni dokumentirana (§8 NE izmišljamo).
  okrepitevOpis            String?
  /// §14 "maximum spacing" po orientaciji (mm) — NULL = NI dokumentiran
  /// (npr. KUBO pokončno) → zahteva eksplicitne pozicije (SDK kanon S+8.1).
  maxPostSpacingH          Int?
  maxPostSpacingV          Int?
  maxRailSpacingV          Int?
  /// JSON kvalifikatorjev razmaka [{key,maxSpacingMm}] — NE-baza/h/v ključi
  /// iz maxPostSpacingMm zapisa kataloga (horizontalWithMidConnection …).
  razmakKvalifikatorjiJson String
  gapMinMm                 Int
  gapMaxMm                 Int
  /// JSON ročaja (handle iz kataloga — zod v catalog-domain).
  rocajJson                String
  /// JSON posebnosti (specialFeatures iz kataloga — sledljivost vira).
  posebnostiJson           String
  /// pending | granted | rejected (CHECK) — pariteta SDK RightsStatus.
  pravice                  String
  /// JSON virov (sourceUrls iz kataloga — §14 "rights/source").
  viriJson                 String
  aktivna                  Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  family           ProductFamily            @relation(fields: [familyId], references: [id], onDelete: Restrict)
  catalogVersion   ProductCatalogVersion    @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  applications     ProductApplication[]
  variants         ProductVariant[]
  compatSource     ProductCompatibility[]   @relation("ProductCompatSource")
  compatTarget     ProductCompatibility[]   @relation("ProductCompatTarget")
  supplierMappings ProductSupplierMapping[]
  engineeringRules EngineeringRule[]          // R393 §15 — tehnična pravila vezana na ta produkt

  @@index([familyId])
  @@index([catalogVersionId])
  @@index([kategorija])
}

/// R390 (§14): ProductApplication — EKSPPLICITNI aplikacijski kontekst.
/// §14 nabor EXACT: HORIZONTALNA_OGRAJA | POKONCNA_OGRAJA | TERASA |
/// PREDELNA_STENA | FASADA | STROP. ODSOTNOST vrstice = aplikacija NI
/// dokumentirana (fail-closed — npr. KUBO uradno SAMO fasada, balkonska
/// ograja odkrito NE dokumentirana). maxRazmakMm = razmak v kontekstu
/// aplikacije (mm); NULL = neznano (§8).
model ProductApplication {
  id          String   @id @default(cuid())
  productId   String
  aplikacija  String
  /// horizontal | vertical (CHECK).
  orientacija String
  maxRazmakMm Int?
  /// Citat vira — katera stran/pravilo kataloga dokumentira aplikacijo.
  vir         String
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, aplikacija, orientacija])
  @@index([aplikacija])
  @@index([orientacija])
}

/// R390 (§14): ProductVariant — barvna/površinska izvedba produkta.
/// Seed r390 je PRAZEN (§8): colorsCount v katalogu je ŠTEVEC (4–8), ne
/// enumeracija — katere barve veljajo za katere profile katalog NE imenuje,
/// zato vrstic NE izmišljamo; vpiše jih pisarca prek API-ja.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  /// EXACT šifra variante — kanon §5 brez fuzzy.
  sifra     String   @unique
  naziv     String
  /// Id barve iz družinske palete (EXACT) — NULL = barvna izvedba ni vezana.
  barvaId   String?
  /// approxHex iz palete — NULL = uradni hex NE obstaja (SDK kanon).
  barvaHex  String?
  povrsina  String?
  aktivna   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// R390 (§14): ProductAccessory — Fixing/Accessory (čepi, letve, pokrovčki,
/// ročaj, steber). Šifra = EXACT id dodatka iz kataloga.
model ProductAccessory {
  id                String   @id @default(cuid())
  sifra             String   @unique
  familyId          String
  naziv             String
  /// JSON dimenzije [92,45,5800] — NULL = ni dokumentirano (§8).
  dimenzijeJson     String?
  /// JSON notranjih mer [55,30] — NULL = ni dokumentirano (§8).
  notranjeMereJson  String?
  opis              String?
  aktivna           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  family        ProductFamily         @relation(fields: [familyId], references: [id], onDelete: Restrict)
  compatTarget  ProductCompatibility[] @relation("AccessoryCompatTarget")

  @@index([familyId])
}

/// R390 (§14): ProductCompatibility — kompatibilne komponente. Cilj je
/// PRODUKT ali DODATEK (CHECK XOR — natanko en). Sejanje r390 pokriva SAMO
/// v katalogu dokumentirane para (opis citira vir).
model ProductCompatibility {
  id                    String   @id @default(cuid())
  productId             String
  kompatibilenProductId String?
  kompatibilenDodatekId String?
  /// Citat vira kompatibilnosti (katalog besedilo) — sledljivost.
  opis                  String?
  createdAt             DateTime @default(now())

  product             Product              @relation("ProductCompatSource", fields: [productId], references: [id], onDelete: Cascade)
  kompatibilenProduct Product?             @relation("ProductCompatTarget", fields: [kompatibilenProductId], references: [id], onDelete: Restrict)
  kompatibilenDodatek ProductAccessory?    @relation("AccessoryCompatTarget", fields: [kompatibilenDodatekId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([kompatibilenProductId])
  @@index([kompatibilenDodatekId])
}

/// R390 (§14): ProductSupplierMapping — preslikava produkta na dobavitelja
/// z veljavnostnim intervalom (§14 "supplier mapping" + "effective dates").
/// Prekrivanje intervalov istega (produkt, dobavitelj) → 409 v store-plasti.
/// Seed PRAZEN (§8): katalog ne dokumentira dobaviteljskih preslikav.
model ProductSupplierMapping {
  id           String   @id @default(cuid())
  productId    String
  supplierId   String
  veljavnostOd DateTime
  /// NULL = velja do preklica (odprt interval).
  veljavnostDo DateTime?
  opomba       String?
  /// Mehka revizijska referenca na Profile (vzorec R374/R378 — brez FK).
  createdById  String?
  createdAt    DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([productId, supplierId, veljavnostOd])
  @@index([productId])
  @@index([supplierId])
}

/// R393 (issue #13, korak R171 iz §15) — ENGINEERING / COMPLIANCE
/// VERSIONING: identiteta tehničnega pravila (stabilna šifra čez verzije).
/// Vsebinske + izvorne lastnosti živijo na VERZIJI (immutable snapshot) —
/// sprememba pravila = NOVA verzija prek DRAFT→ACTIVE→RETIRED stroja,
/// NE tiho prefinjanje obstoječe vrstice (issue #13 §15 + kanon R373/R390).
model EngineeringRule {
  id          String   @id @default(cuid())
  /// EXACT kanonska šifra pravila (npr. 'MONT-SPLOSNO-01') — kanon §5 brez fuzzy.
  sifra       String   @unique
  naziv       String
  /// MONTAZA | RAZMAK | MATERIAL | OBREMENITEV | GEOMETRIJA (CHECK v migraciji).
  kategorija  String
  /// §15 "application" — §14 EXACT nabor (HORIZONTALNA_OGRAJA|POKONCNA_OGRAJA|
  /// TERASA|PREDELNA_STENA|FASADA|STROP); NULL = splošno (vse aplikacije).
  aplikacija  String?
  /// Produkt-specifično pravilo (npr. razmaki profilov); NULL = splošno.
  productId   String?
  /// horizontal | vertical (CHECK) — pri razmakih; NULL = nevezano na orientacijo.
  orientacija String?
  aktivno     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions EngineeringRuleVersion[]
  product  Product?               @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([kategorija])
  @@index([aplikacija])
  @@index([productId])
}

/// R393 (§15): verzija pravila — IMMUTABLE zapis, ki nosi VSAKO §15 polje:
/// rule id (FK na identiteto), source (vir), standard/reference, standard
/// version, jurisdiction, application (na identiteti), effectiveFrom,
/// reviewedAt, reviewer, calculator version + overitev — LOČITEV
/// informativnega inženirskega izračuna od uradnega projektantskega oziroma
/// statičnega preverjanja (§15: "Informativni engineering calculation mora biti
/// jasno ločen od uradnega projektantskega/statističnega preverjanja.").
/// URADNO (PROJEKTANTSKA/STATISTICNA) ZAHTEVA reviewedAt + reviewerId —
/// nepreverjeno pravilo LAHKO je SAMO INFORMATIVNO (store guard + partial
/// UNIQUE). Honest NULL (§8): standardReferenca/standardVerzija/jurisdikcija/
/// reviewedAt/reviewerId/calculatorVerzija so NULL, ko vir NE dokumentira.
model EngineeringRuleVersion {
  id        String   @id @default(cuid())
  ruleId    String
  /// Zaporedna številka verzije tega pravila (per pravilo, 1 = seed).
  verzija   Int
  /// DRAFT | ACTIVE | RETIRED (CHECK; stroj v engineering-rules-store).
  status    String
  /// Vsebina pravila — CITAT vira (byte-exact iz kataloga/kalkulatorja).
  vsebina   String
  /// Strukturirana vrednost (JSON, zod v engineering-rules-domain); NULL = čisto besedilno pravilo.
  strukturaJson String?
  /// §15 "source" — KATALOG_PROIZVAJALCA | URADNI_STANDARD |
  /// INTERNI_INZENIRING | SEKUNDARNI_VIR (CHECK).
  vir       String
  /// Citat vira (URL/dokument/vrstice kode) — sledljivost.
  virZapis  String?
  /// §15 "standard/reference" — NULL = pravilo NI standardno utemeljeno (§8 — NE izmišljamo).
  standardReferenca String?
  /// §15 "standard version" — NULL = vir ne dokumentira verzije standarda (§8).
  standardVerzija   String?
  /// §15 "jurisdiction" — NULL = neznana ali ni relevantna (§8).
  jurisdikcija      String?
  /// LOČITEV (§15): INFORMATIVNO | PROJEKTANTSKA | STATISTICNA (CHECK).
  overitev  String
  /// §15 "calculator version" — verzija formule/kalkulatorja, ki pravilo porablja;
  /// NULL = pravilo ni porabljeno v kalkulatorju (ročna navodila — odkrito).
  calculatorVerzija String?
  /// §15 "effectiveFrom".
  veljavnostOd DateTime
  /// NULL = odprt interval — velja do preklica (§8).
  veljavnostDo DateTime?
  /// §15 "reviewedAt" — NULL = NI pregledano (honest; URADNO brez tega = zavrnjeno).
  reviewedAt DateTime?
  /// §15 "reviewer" — mehka referenca na Profile (vzorec R374/R378 — brez FK);
  /// NULL = pregledalca NI (§8).
  reviewerId String?
  /// Mehka revizijska referenca na Profile (vzorec R374/R378 — brez FK).
  createdById String?
  createdAt DateTime @default(now())

  rule EngineeringRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([ruleId, verzija])
  @@index([status])
  @@index([ruleId, status])
  @@index([vir])
  @@index([overitev])
}
