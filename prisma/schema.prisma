  naziv      String   @unique
  kontakt    String?
  email      String?
  telefon    String?
  naslov     String?
  iban       String?
  dobavniRok Int      @default(7) // dni
  popust     Float    @default(0) // % popust za Roksal
  aktivna    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  materialPrices MaterialPrice[]
  orders         MaterialOrder[]
  lots           InventoryLot[]
}

// Cena materiala pri posameznem dobavitelju (zgodovina cen)
model MaterialPrice {
  id           String    @id @default(cuid())
  inventoryId  String
  supplierId   String
  cena         Float // EUR na enoto
  veljavnostOd DateTime  @default(now())
  veljavnostDo DateTime?
  opomba       String? // npr. "akcijska cena", "letni okvir"
  createdAt    DateTime  @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  supplier  Supplier  @relation(fields: [supplierId], references: [id])

  @@index([inventoryId, supplierId])
  @@index([veljavnostOd])
}

// Naročilo materiala (V5 — iz BOM draft v naročilo)
model MaterialOrder {
  id            String    @id @default(cuid())
  projectId     String?
  supplierId    String
  status        String    @default("OSNUTEK") // OSNUTEK | POSLANO | POTRJENO | DOBLJENO | PREKlicANO
  skupajCena    Float     @default(0)
  datumNarocila DateTime  @default(now())
  datumDobave   DateTime?
  opombe        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project  Project?            @relation(fields: [projectId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    MaterialOrderItem[]
  lots     InventoryLot[]
}

// Posamezna postavka naročila
model MaterialOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  inventoryId String
  kolicina    Float
  cena        Float // cena na enoto ob naročilu
  naziv       String // snapshot naziva
  enota       String // snapshot enote
  createdAt   DateTime @default(now())

  order     MaterialOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory Inventory      @relation(fields: [inventoryId], references: [id])
  lots      InventoryLot[]

  @@index([orderId])
}

// ============================================
// 19. V6 — LOGISTICS / ERP (ekipe, oprema, koledar montaže)
// ============================================

model Crew {
  id        String   @id @default(cuid())
  naziv     String   @unique // npr. "Ekipa A", "Ekipa Kranj"
  vodjaId   String? // Profile.id vodje ekipe
  aktivna   Boolean  @default(true)
  barva     String   @default("#1d2b3e") // za prikaz v koledarju
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vodja     Profile?               @relation("CrewLeader", fields: [vodjaId], references: [id])
  members   Profile[]
  schedules InstallationSchedule[]

  @@index([aktivna])
}

model Equipment {
  id           String    @id @default(cuid())
  naziv        String    @unique // npr. "Laser Bosch GLM 50C", "Vijačnik", "Avtomobil A"
  tip          String // "MERSKA_OPREMA" | "ROČNO_ORODJE" | "PREVOZ" | "VARNOSTNA_OPREMA" | "OSTALO"
  sifra        String?
  status       String    @default("NA_VOLJO") // NA_VOLJO | V_UPORABI | V_SERVISU | IZGUBLJENO | UPOKOJENO (§31; CHECK v migraciji r145)
  lokacija     String? // npr. "Skladišče Kranj", "Avto A"
  zadnjiServis DateTime?
  opomba       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // R145 (§31 Equipment lifecycle): serijska številka, pridobitev, pregledi
  // in kalibracije. Kalibracija je POGOJ za mersko opremo (backfill:
  // tip='MERSKA_OPREMA' → calibrationRequired=true — deterministično, brez
  // ugibanja); rok (calibrationDueDate) + potrdilo vpisuje izvedeni pregled.
  serijskaStevilka       String? // §31 "serial number"
  pridobitev             DateTime? // §31 "acquisition"
  lastInspectionAt       DateTime? // zadnji PREGLED (iz EquipmentEvent)
  inspectionIntervalDays Int? // pogostost pregleda v dneh; null = brez periodike
  calibrationRequired    Boolean   @default(false) // merska oprema = true (fail-closed)
  calibrationDueDate     DateTime? // rok naslednje kalibracije (s potrdila)
  calibrationCertificate String? // §31 "certificate" — naziv/številka potrdila

  assignments EquipmentAssignment[]
  events      EquipmentEvent[]

  @@index([status])
}

// R145 (§31): zgodovina pregledov/kalibracij/servisov/Popravil opreme.
// Neomejen vpis je PRETEKLOST — ni stropov (revizija življenjskega cikla,
// podobno AuditLogu: pravno/tehnično pomembna sled se NE čišči).
model EquipmentEvent {
  id            String   @id @default(cuid())
  equipmentId   String
  type          String // PREGLED | KALIBRACJA | SERVIS | POPRAVILO
  performedAt   DateTime // kdaj je bilo izvedeno (nikoli v prihodnosti — 400)
  result        String   @default("V_REDU") // V_REDU | NAPAKA
  certificate   String? // potrdilo o kalibraciji (obvezno za KALIBRACIJO na merski opremi)
  opomba        String?
  performedById String?
  performedBy   Profile? @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, performedAt])
}

// Termin montaže v koledarju
model InstallationSchedule {
  id            String   @id @default(cuid())
  projectId     String
  crewId        String?
  monterId      String? // glavni monter (Profile.id)
  datumZacetka  DateTime
  datumKonca    DateTime
  status        String   @default("NAVRTENO") // NAVRTENO | V_TEKU | ZAKLJUCENO | PREKlicANO | PRELOZENO
  predvideneUre Int      @default(8)
  dejanskeUre   Int?
  opombe        String?
  lokacija      String? // naslov montaže
  gpsLat        Float?
  gpsLon        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project              Project                @relation(fields: [projectId], references: [id])
  crew                 Crew?                  @relation(fields: [crewId], references: [id])
  monter               Profile?               @relation("MonterSchedules", fields: [monterId], references: [id])
  equipment            EquipmentAssignment[]
  qualityControls      QualityControl[] // R146 §27 — preverbe kakovosti povezane s terminom
  installationEvidence InstallationEvidence[] // R147 §28 — montažna dokazila termina

  @@index([datumZacetka])
  @@index([crewId])
  @@index([status])
}

// R146 (issue #5 §27 — Quality control gate): struktuirana preverba kakovosti
// pred zaključitvijo termina/prehodom projekta v MONTIRANO.
//
// Kontrolni seznam je DETERMINISTIČEN in živi v kodi (lib/qc-gate.ts,
// QC_TEMPLATE z verzijo) — vrstic NI v bazi, zato ni plesa sheme ob spremembi
// seznama; sprememba seznama = nova verzija (templateVersion), stare zapisi
// ostanejo berljivi z njihovo verzijo. itemsJson je strogo validiran
// (validateQCItems: natanko ključi predloge, boolean checked, opomba OBVEZNA
// pri neizpolnjeni postavki — napaka brez ukrepa se ne zapiše). Fail-closed
// vrata so v PATCH /api/schedules: ZAKLJUCENO brez PREŠLE preverbe zahteva
// izrecen qcOverrideReason (revizirano QC_OVERRIDE).
model QualityControl {
  id              String   @id @default(cuid())
  projectId       String
  scheduleId      String?
  templateVersion String
  itemsJson       String // JSON — oblika številka QC_TEMPLATE_VERSION
  passed          Boolean
  defectsCount    Int // število neizpolnjenih postavk (deterministično)
  note            String? // povzetek korektivnih ukrepov (opcijsko)
  approvedById    String?
  approvedBy      Profile? @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedule InstallationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([projectId, approvedAt])
  @@index([scheduleId])
}

// R147 (issue #5 §28) — Struktuirano montažno dokazilo: pred/po, lokacija,
// čas, akter, projekt, GPS (SAMO z izrecnim dovoljenjem — gpsConsentAt),
// checklist (verzirana predloga), merilni dokaz, poraba materiala (IZVEDENA
// s strežnika iz StockLedger — nikoli iz klienta), napake, dokaz predaje.
model InstallationEvidence {
  id              String    @id @default(cuid())
  projectId       String
  scheduleId      String?
  templateVersion String // "iev-v1" — sprememba seznama = nova verzija
  lokacija        String // kje je bila montaža (obvezno, ≤ 300 znakov)
  beforePhotoId   String?
  afterPhotoId    String?
  /// GPS po policyju: shranjeno IZKLJUČNO z izrecnim dovoljenjem terenskega
  /// uporabnika (gpsConsentAt = čas soglasja). Brez soglasja = null (ne tiho).
  gpsLat          Float?
  gpsLng          Float?
  gpsConsentAt    DateTime?
  /// JSON po obliki IEV_TEMPLATE_VERSION (isti fail-closed vzorec kot QC).
  checklistJson   String
  /// Merilni dokaz (povezana VERIFIED meritev istega projekta).
  measurementId   String?
  /// JSON lista napak: [{ opomba, reseno }] — strogo validirana (≤ 20).
  defectsJson     String
  /// Dokaz predaje: ime predaja + čas. Zakleni dokazilo (nič več ni spreminljivo).
  handoverName    String?
  handoverAt      DateTime?
  note            String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedule    InstallationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  beforePhoto ProjectPhoto?         @relation("EvidenceBeforePhoto", fields: [beforePhotoId], references: [id], onDelete: SetNull)
  afterPhoto  ProjectPhoto?         @relation("EvidenceAfterPhoto", fields: [afterPhotoId], references: [id], onDelete: SetNull)
  measurement Measurement?          @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  createdBy   Profile?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([scheduleId])
}

// Oprema dodeljena terminu montaže
model EquipmentAssignment {
  id          String   @id @default(cuid())
  scheduleId  String
  equipmentId String
  datumOd     DateTime
  datumDo     DateTime
  opomba      String?
  createdAt   DateTime @default(now())

  schedule  InstallationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  equipment Equipment            @relation(fields: [equipmentId], references: [id])

  @@index([scheduleId])
  @@index([equipmentId])
}

// R148 (issue #5 §36 — Mobile sync conflict model): naprava (mobilni klient)
// v sync protokolu. deviceId generira klient (stabilen UUID), strežnik ga
// samo zabeleži (lenobni upsert ob vsaki sync zahtevi z X-Device-Id).
model SyncDevice {
  id             String   @id @default(cuid())
  deviceId       String   @unique
  name           String?
  /// ApiKey, ki je napravo uvedel (SetNull — ključ se lahko izbriše).
  apiKeyId       String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  /// Nazadnje videna revizija (lenobni zapis ob GET ?sinceRevision=…).
  lastSyncCursor Int      @default(0)

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
}

// R148 (§36) — grobnica: mobilni projekt je IZBRISAN iz sync zrcala
// (DELETE /api/sync). Preživi brisanje projekta (projectId SetNull —
// ni cascade!), zato ponovni sync istega mobileProjectId NE ustvari
// dvojnika, ampak dobi iskren 409-style rezultat "tombstone".
model SyncTombstone {
  id              String   @id @default(cuid())
  mobileProjectId String   @unique
  reason          String
  tombstonedAt    DateTime @default(now())
  createdById     String?
  /// Projekt, če je vrstica še živa (SetNull — grobnica preživi brisanje).
  projectId       String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy Profile? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tombstonedAt])
}

// ============================================
// API KLJUCI (mobilni klient: BalkonAR)
// ============================================
//
// Prej je /api/sync "avtenticiral" s preverjanjem predpone
// `key.startsWith('ROKSAL_MOBILE_') && key.length >= 20` — oblika je bila v javnem
// repu, torej je bil vsak, ki jo je poznal, pooblaščen za pisanje v bazo.
// Zdaj se hrani samo SHA-256 ključa, ključ je viden enkrat ob ustvarjanju,
// posamezen ključ pa je mogoče preklicati brez menjave ostalih.
model ApiKey {
  id         String    @id @default(cuid())
  /// Človeško berljivo ime ("Marko - telefon", "BalkonAR test").
  name       String
  keyHash    String    @unique
  /// Prvih 12 znakov za prepoznavo v seznamu (brez razkritja ključa).
  keyPrefix  String
  createdBy  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  // ── R126 — issue #5 §3: API-key lifecycle ────────────────────────────────
  /// Namenska raba ključa ("BalkonAR mobilni klient terenske ekipe").
  purpose         String?
  /// Scope lista (R126 §3), ločena z vejico. Privzeto dobrodelni nabor
  /// MOBILE_SYNC iz matrike v src/lib/access.ts. Katalog: src/lib/api-keys.ts.
  scopes          String    @default("projects:read,projects:write,measurements:create,photos:read,photos:write")
  /// Omejitev na projekte (ID-ji ločeni z vejico). Null/prazno = vsi projekti
  /// (sync zrcalo podjetja — dosedanja pogodba MOBILE_SYNC).
  projectScope    String?
  /// Ko ključ poteče, ga verifyApiKey zavrne (fail-closed). Null = ne poteče.
  expiresAt       DateTime?
  /// ID predhodnika, če je ključ nastal z rotacijo (--rotate).
  rotatedFrom     String?
  /// Per-key omejitev hitrosti (zahtevkov/minuto). Null = privzeto 120.
  rateLimitPerMin Int?

  /// R148 (§36) — naprave, ki jih je ključ uvedel v sync protokol.
  syncDevices SyncDevice[]
}

// ============================================
// PREJEMNI ZAPISNIK (punch list / closeout)
// ============================================
// Kontrolni seznam pred predajo projekta naročniku:
// meja/soglasja, montaža, čiščenje, predaja dokumentacije.
model PunchItem {
  id        String   @id @default(cuid())
  projectId String
  naslov    String
  opomba    String?
  status    String   @default("open") // open | done | issue
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// RAČUNI (FURS layer — predračun / račun / predplačilni račun)
// ============================================
// Slovenski zakonski obvezni podatki računa (ZDDV-1, 37. člen):
// zaporedna številka, datum izdaje, podatek o prostoru/napravi,
// izdajatelj (davčna št.), naročnik, postavke, DDV 22 %, rok plačila.
// Postavke in kupec so JSON snapshot — račun se ne spreminja, če se
// kasneje spremenita projekt ali BOM (račun je pravnok act dokument).
model Invoice {
  id            String    @id @default(cuid())
  projectId     String
  tip           String    @default("RACUN") // PREDRACUN | RACUN | PREDPLACILNI
  /// Zaporedna številka oblike "2026-001" (per leto, enota: Roksal d.o.o.)
  stevilka      String    @unique
  datumIzdaje   DateTime  @default(now())
  datumStoritve DateTime?
  rokPlacilaDni Int       @default(8)
  status        String    @default("OSNUTEK") // OSNUTEK | IZDAN | PLACAN | STORNIRAN
  placanoAt     DateTime?
  /// Postavke JSON: [{opis, kolicina, enota, cenaNaEnoto, ddvStopnja}]
  postavke      String
  /// Snapshot kupca ob izdaji: {ime, naslov, telefon?, email?, davcnaSt?}
  kupec         String?
  /// Skupaj brez DDV (EUR)
  osnova        Float     @default(0)
  /// DDV 22 % (EUR)
  ddv           Float     @default(0)
  /// Za plačilo (EUR)
  znesek        Float     @default(0)
  opombe        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  /// R136 (§18): dashboard/pregled filtrira "projekt + status" — kompozitni
  /// indeks pade iz dveh posameznih na en range scan.
  @@index([projectId, status])
}

// ============================================
// 20. TERENSKI PREGLED — zapisnik monterja pred montažo (runda Q)
// En zapisnik na projekt (upsert): kaj monterja čaka na objektu + pametni
// seznam "s seboj prinesti" (orodje/mozniki) glede na podlago, pritrditev, ovire.
// ============================================
model SiteSurvey {
  id                String   @id @default(cuid())
  projectId         String   @unique
  tipObjekta        String   @default("balkon") // balkon|stopnice|terasa|loggia|friz|prehod
  oblika            String   @default("ravno") // ravno|L|U|krog
  pritrditev        String   @default("obrobna") // obrobna|tloris|stena|mesano
  podlaga           String   @default("neznan") // beton|estrih|les|kovina|plocice|neznan
  razponNajdaljsiMm Int?
  skupnaDolzinaMm   Int?
  visinaMm          Int?
  steviloStopnic    Int?
  razhodMm          Int?
  /// CSV ovir: cevi|vticnice|podstavki|osvetlitev|okna|locnik|vlaga|druge
  ovire             String?
  dvigalo           Boolean  @default(false)
  dostopOpomba      String?
  /// CSV posnetih točk foto kontrolnega seznama: tip1|meritve|podlaga|pritrditev|ovire|celota
  fotoPosneto       String?
  /// RAL barva prahu izbrana na terenu (runda R): 7016|9005|9016|6005|8017
  ralCode           String?
  opombe            String?
  zakljuceno        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([zakljuceno])
}

// ============================================
// 21. VIZ (Vizualizacija ograje) — runda S+2
// Spec: docs/VIZ_CONTRACTS.md (single source of truth)
// Datoteke na disku: public/viz/projects/<id>/ (original.jpg, product.jpg,
// product-mask.png, mask.png, placement.json, preview.jpg, result.json)
// — gitignore-ane runtime mape; poti v bazi so javni URL-ji (/viz/projects/...).
// placement in variants sta JSON string (SQLite nima JSON tipa).
// ============================================

model VizProject {
  id              String         @id @default(cuid())
  // S+4 lastništvo: Profile.id seje, ki je projekt ustvarila. Null = zapuščina
  // iz rund pred S+4 (vidijo jo samo ADMIN — glej docs/VIZ_CONTRACTS.md).
  ownerId         String?
  name            String
  originalPath    String
  productPath     String
  productMaskPath String?
  maskPath        String
  previewPath     String?
  resultPath      String?
  resultImagePath String?
  placement       String
  variants        String?
  idempotencyKey  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  renderJobs      VizRenderJob[]

  @@index([ownerId])
}

// GPU render job stub (Qwen-Image-Edit-2509) — nikoli ne oznacimo 'completed',
// dokler GPU backend ne obstaja. Statusi: queued | processing | completed | failed
model VizRenderJob {
  id         String     @id @default(cuid())
  // S+4: lastnik joba = seja, ki je job ustvarila (null = zapuščina, ADMIN only).
  ownerId    String?
  projectId  String
  project    VizProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     String     @default("queued")
  engine     String     @default("qwen-image-edit-2509")
  inputJson  String
  resultPath String?
  error      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([projectId])
  @@index([status])
}

// ============================================
// IDEMPOTENCA (R128 — issue #5 §4: offline vrsta)
// ============================================
// Terenski klient pošilja čakajoče zapise s stabilnim `Idempotency-Key`
// (klient mutacijski ID). Strežnik shrani snapshot odgovora — ponovitev
// istega ključa vrne ORIGINALNI odgovor in ne ustvari dvojnika (npr. dve
// meritvi iz istega offline zapisa po več poizkusih pošiljanja).
// Ključ je vezan na profil (profileId) — tuj ključ ne razkrije odgovora.
model IdempotencyKey {
  key            String   @id
  /// Katera raba (route family): "measurements" | "ar-snapshots" …
  route          String
  /// Lastnik ključa (avtorizacija replaya) — null = rezervacija brez seje.
  profileId      String?
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

/// R132 (issue #5 §7): dostopni dnevnik javnega portala stranke.
/// Vsak poskus (uspešen ali ne) se zabeleži — revizija javne površine.
/// ipHash = sha256(IP + API_KEY_PEPPER), 32 hex znakov — zasebnost obiskovalcev.
model PortalAccess {
  id        String   @id @default(cuid())
  /// null = poskus z neobstoječim žetonom (nismo podigli projekt).
  projectId String?
  /// OK | NOT_FOUND | DISABLED | EXPIRED | REVOKED | RATE_LIMITED | INVALID
  status    String
  ipHash    String
  userAgent String?
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
}

/// R141 (issue #5 §23 — Background jobs): enoten register poslov (job ledger).
///
/// Vsak zagon vzdrževalnega posla (GC idempotenčnih ključev, GC dostopov
/// portala, GC starih sej …) ima VRSTICO z vsemi zahtevami §23:
///   • job ID          = `id` (cuid) — povezljiv z logi prek correlationId;
///   • owner           = kdo je sprožil: "cron" (Vercel Cron) ali e-mail
///                       ADMIN-a pri ročnem zagonu prek UI;
///   • input           = JSON parametri zagona (okno, pragovi);
///   • status          = RUNNING | SUCCEEDED | FAILED;
///   • attempts        = števec poskusov znotraj istega okna (okno = dan);
///   • retry policy    = maxAttempts + dokumentirana naravna ponovitev
///                       (dnevni cron poskusi naslednji dan znova);
///   • error           = lastError (sanitiziran prek correlationErrorSummary —
///                       brez stacka, brez Prisma internals, §22 pogodba);
///   • idempotency     = idempotencyKey (type + okno) UNIQUE — dvakrat isti
///                       dan = replay (drugi zagon NE dela dvojno delo);
///   • correlation ID  = nosilec povezave z Vercel logi istega zagona.
model JobRun {
  id             String    @id @default(cuid())
  type           String
  owner          String
  input          String?
  status         String
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  correlationId  String
  idempotencyKey String    @unique
  result         String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?

  @@index([type, createdAt])
  @@index([createdAt])
}
