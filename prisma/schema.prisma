  projectId  String
  naziv      String
  // R121: bajti v object storage; pngData = zapuščinska vrstica (backfill).
  pngData    String? // zapuščina: base64 PNG
  storageKey String?
  mime       String?
  sizeBytes  Int?
  sha256     String?
  povzetek   String? // besedilni opis skice
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// 14. GALERIJA REALIZACIJ
// ============================================

model GalleryItem {
  id              String   @id @default(cuid())
  projectId       String?
  profilId        String?
  naslov          String
  opis            String?
  lokacija        String?
  // R121: bajti v object storage; slikaPred/slikaPo = zapuščinske vrstice (backfill).
  slikaPred       String? // zapuščina: base64 ali URL
  slikaPo         String? // zapuščina: base64 ali URL
  slikaPredKey    String?
  slikaPredMime   String?
  slikaPredSize   Int?
  slikaPredSha256 String?
  slikaPoKey      String?
  slikaPoMime     String?
  slikaPoSize     Int?
  slikaPoSha256   String?
  javno           Boolean  @default(false)
