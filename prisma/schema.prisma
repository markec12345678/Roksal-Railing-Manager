// Roksal Field v2.4 - SQLite Production Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. UPORABNIKI IN VLOGE
// ============================================

enum UserRole {
  ADMIN
  VODJA
  MONTER
  SKLADISCE
}

model Profile {
  id         String    @id @default(cuid())
  ime        String
  email      String    @unique
  vloga      UserRole  @default(MONTER)
  telefon    String?
  ekipaId    String?
  lastActive DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projects   Project[] @relation("InstallerProjects")
  leads      Project[] @relation("ManagerProjects")
  auditLogs  AuditLog[]
  crew       Crew?     @relation(fields: [ekipaId], references: [id])
  leadsCrew  Crew[]    @relation("CrewLeader")
  schedules  InstallationSchedule[] @relation("MonterSchedules")
}

// ============================================
// 2. STRANKE
// ============================================

model Customer {
  id        String    @id @default(cuid())
  ime       String
  naslov    String
  telefon   String?
  email     String?
  createdAt DateTime  @default(now())

  // V4.2 — CRM razširitev
  status            String  @default("AKTIVEN")  // AKTIVEN | NEAKTIVEN | POTENCIALEN | ARHIVIRAN
  kontaktnaOseba    String?  // npr. "Janez Novak (predsednik uprave)"
  opomnikDatum      DateTime?  // opomnik za ponovni kontakt
  opomnikOpis       String?  // "Letni pregled balkonov"
  zadnjiKontakt     DateTime?
  opombeCRM         String?  // interne opombe (ne za stranko)
  kategorija        String?  // "Stanovanjska skupnost" | "Posameznik" | "Podjetje"

  projects  Project[]
}

// ============================================
// 3. PROJEKTI - Centralno vozlišče
// ============================================

enum ProjectStatus {
  NACRTOVANO
  V_TEKU
  ZAKLJUCENO
  USTAVLJENO
  ZA_MONTAZO   // V4.1 — podpisano, čaka na montažo
  V_IZDELAVI   // V6 — material v izdelavi/dobavi
  MONTIRANO    // V6 — montaža zaključena
}

model Project {
  id            String        @id @default(cuid())
  customerId    String
  nazivProjekta String
  status        ProjectStatus @default(NACRTOVANO)
  monterId      String?
  vodjaId       String?
  ekipaId       String?
  datumMontaze  DateTime?
  opombe        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  mobileProjectId   String?
  originalImagePath String?
  geminiEstimate    String?
  latitude          Float?
  longitude         Float?
  projectData       String?

  // PORTAL STRANKE — javna stran za sledenje napredku
  clientToken          String   @unique @default(cuid())
  clientPortalEnabled  Boolean  @default(false)
  clientNotes          String?  // sporočilo monterja, vidno stranki
  estimatedPrice       Float?   // predvidena cena, vidna stranki

  // V4.1 — POST-SIGNATURE AUTOMATION LAYER
  dealLocked          Boolean   @default(false)  // true po podpisu — nič več editanja
  dealLockedAt        DateTime?
  dealSignedBy        String?   // ime/podpis stranke
  dealSignedByMonter  String?   // ime monterja
  dealSignatureIp     String?   // IP naslov ob podpisu
  dealSignatureDevice String?   // User-Agent ob podpisu
  bomDraftJson        String?   // BOM (Bill of Materials) draft JSON — ne naročilo še
  marginLocked        Float?    // zaklenjena marža ob podpisu

  customer      Customer       @relation(fields: [customerId], references: [id])
  monter        Profile?       @relation("InstallerProjects", fields: [monterId], references: [id])
  vodja         Profile?       @relation("ManagerProjects", fields: [vodjaId], references: [id])
  measurements  Measurement[]
  documents     Document[]
  materials     MaterialUsage[]
  auditLogs     AuditLog[]
  inventoryMoves InventoryMovement[]
  arSnapshots   ArSnapshot[]
  sketches      Sketch[]
  slopes        Slope[]
  galleryItems  GalleryItem[]
  photos        ProjectPhoto[]
  signatureAudits SignatureAudit[]
  materialOrders MaterialOrder[]
  schedules     InstallationSchedule[]
}

// ============================================
// 4. MERITVE - AR/LiDAR podpora
// ============================================

model Measurement {
  id           String   @id @default(cuid())
  projectId    String
  dolzinaMm    Int
  visinaMm     Int
  lidarScanUrl String?
  arMetadata   String?
  gpsLokacija  String?
  createdAt    DateTime @default(now())
  createdBy    String?

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// 5. ZALOGA IN INVENTAR
// ============================================

model Inventory {
  id              String              @id @default(cuid())
  sifraMateriala  String              @unique
  naziv           String
  tip             String
  kolicinaZaloga  Float               @default(0)
  enota           String
  minimalnaZaloga Float               @default(5)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  usages          MaterialUsage[]
  movements       InventoryMovement[]
  prices          MaterialPrice[]
  orderItems      MaterialOrderItem[]
}

// ============================================
// 6. PORABA MATERIALA NA PROJEKTU
// ============================================

model MaterialUsage {
  id                  String    @id @default(cuid())
  projectId           String
  inventoryId         String
  porabljenaKolicina  Float
  datumVpisa          DateTime  @default(now())

  project   Project   @relation(fields: [projectId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

// ============================================
// 7. PREMIKI ZALOGE
// ============================================

model InventoryMovement {
  id          String    @id @default(cuid())
  inventoryId String
  projectId   String?
  kolicina    Float
  tipPremika  String
  createdAt   DateTime  @default(now())
  createdBy   String?

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])
}

// ============================================
// 8. DOKUMENTI
// ============================================

enum DocumentType {
  TEHNICNI_LIST
  PRIMOPREDAJA
  E_RACUN
  ZAPISNIK_NAVORA
}

model Document {
  id           String       @id @default(cuid())
  projectId    String
  pdfUrl       String?
  signatureUrl String?
  tipDokumenta DocumentType @default(TEHNICNI_LIST)
  status       String       @default("GENERIRANO")
  createdAt    DateTime     @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// 9. AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  akcija    String
  oldValue  String?
  newValue  String?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  user    Profile  @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}

// ============================================
// 10. OBVESTILA
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  naslov    String
  sporocilo String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================
// 11. KATALOG PROFILOV OGRAJ (Roksal)
// ============================================

model Profil {
  id          String   @id @default(cuid())
  sifra       String   @unique
  naziv       String
  material    String   // alu / inox / wpc / steklo
  kategorija  String   // npr. "WPC H-Line", "Inox Line", "Steklo"
  visinaMm    Int      @default(1100)
  sirinaMm    Int      @default(140)
  cenaM       Float    // EUR na meter linearni
  barvaRal    String?  // privzeta RAL koda
  slikaUrl    String?
  aktivna     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  arSnapshots  ArSnapshot[]
  galleryItems GalleryItem[]
}

// ============================================
// 12. AR POSNETKI (kamera + točke + vizualizacija)
// ============================================

model ArSnapshot {
  id         String   @id @default(cuid())
  projectId  String
  profilId   String?
  imageUrl   String   // base64 PNG (video frame + canvas overlay)
  tocke      String   // JSON: [{x,y,label}]
  meritve    String?  // JSON: [{a:{x,y}, b:{x,y}, dolzinaMm, oznaka}]
  kalibracija String? // JSON: {pixelsPerCm}
  opombe     String?
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profil     Profil?  @relation(fields: [profilId], references: [id])
}

// ============================================
// 13. SKICE (ročno risanje na canvas)
// ============================================

model Sketch {
  id         String   @id @default(cuid())
  projectId  String
  naziv      String
  pngData    String   // base64 PNG
  povzetek   String?  // besedilni opis skice
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// 14. GALERIJA REALIZACIJ
// ============================================

model GalleryItem {
  id         String   @id @default(cuid())
  projectId  String?
  profilId   String?
  naslov     String
  opis       String?
  lokacija   String?
  slikaPred  String?  // base64 ali URL
  slikaPo    String?  // base64 ali URL
  javno      Boolean  @default(false)
  createdAt  DateTime @default(now())

  project    Project? @relation(fields: [projectId], references: [id])
  profil     Profil?  @relation(fields: [profilId], references: [id])
}

// ============================================
// 15. NAGIBI (inclinometer meritve)
// ============================================

model Slope {
  id         String   @id @default(cuid())
  projectId  String
  kotStopinje Float   // nagib v stopinjah
  smer       String?  // "X" (horizontal) / "Y" (front-back)
  lokacija   String?  // opis npr. "talna plošča balkona"
  veljaven   Boolean  @default(true)
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// 16. SLIKE PROJEKTA (pred/med/po montaži)
// ============================================

model ProjectPhoto {
  id          String   @id @default(cuid())
  projectId   String
  kategorija  String   // "PRED" | "MED" | "PO"
  imageData   String   // base64 JPEG
  opomba      String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// 17. V4.1 — SIGNATURE AUDIT TRAIL (pravno sledenje)
// ============================================

model SignatureAudit {
  id              String   @id @default(cuid())
  projectId       String
  signatureType   String   // "CUSTOMER" | "MONTER"
  signedByName    String   // ime podpisnika
  signedByRole    String?  // "stranka" | "monter" | "vodja"
  signatureImage  String   // base64 PNG podpisa
  ipAddress       String?
  userAgent       String?
  deviceFingerprint String? // poenostavljen fingerprint (IP + UA hash)
  geoLatitude     Float?
  geoLongitude    Float?
  pdfUrl          String?  // povezava do generiranega PDF (če shranjen)
  pdfHash         String?  // SHA-256 hash PDF vsebine za pravno integriteto
  isValid         Boolean  @default(true)
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

// ============================================
// 18. V5 — MATERIAL INTELLIGENCE (dobavitelji, cene, optimizacija)
// ============================================

model Supplier {
  id            String   @id @default(cuid())
  naziv         String   @unique
  kontakt       String?
  email         String?
  telefon       String?
  naslov        String?
  iban          String?
  dobavniRok    Int      @default(7)  // dni
  popust       Float    @default(0)   // % popust za Roksal
  aktivna       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  materialPrices MaterialPrice[]
  orders         MaterialOrder[]
}

// Cena materiala pri posameznem dobavitelju (zgodovina cen)
model MaterialPrice {
  id            String   @id @default(cuid())
  inventoryId   String
  supplierId    String
  cena          Float    // EUR na enoto
  veljavnostOd  DateTime @default(now())
  veljavnostDo  DateTime?
  opomba        String?  // npr. "akcijska cena", "letni okvir"
  createdAt     DateTime @default(now())

  inventory     Inventory @relation(fields: [inventoryId], references: [id])
  supplier      Supplier  @relation(fields: [supplierId], references: [id])

  @@index([inventoryId, supplierId])
  @@index([veljavnostOd])
}

// Naročilo materiala (V5 — iz BOM draft v naročilo)
model MaterialOrder {
  id            String   @id @default(cuid())
  projectId     String?
  supplierId    String
  status        String   @default("OSNUTEK")  // OSNUTEK | POSLANO | POTRJENO | DOBLJENO | PREKlicANO
  skupajCena    Float    @default(0)
  datumNarocila DateTime @default(now())
  datumDobave   DateTime?
  opombe        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project?  @relation(fields: [projectId], references: [id])
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  items         MaterialOrderItem[]
}

// Posamezna postavka naročila
model MaterialOrderItem {
  id            String   @id @default(cuid())
  orderId       String
  inventoryId   String
  kolicina      Float
  cena          Float    // cena na enoto ob naročilu
  naziv         String   // snapshot naziva
  enota         String   // snapshot enote
  createdAt     DateTime @default(now())

  order         MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory     Inventory    @relation(fields: [inventoryId], references: [id])

  @@index([orderId])
}

// ============================================
// 19. V6 — LOGISTICS / ERP (ekipe, oprema, koledar montaže)
// ============================================

model Crew {
  id          String   @id @default(cuid())
  naziv       String   @unique  // npr. "Ekipa A", "Ekipa Kranj"
  vodjaId     String?  // Profile.id vodje ekipe
  aktivna     Boolean  @default(true)
  barva       String   @default("#1d2b3e")  // za prikaz v koledarju
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vodja       Profile?  @relation("CrewLeader", fields: [vodjaId], references: [id])
  members     Profile[]
  schedules   InstallationSchedule[]

  @@index([aktivna])
}

model Equipment {
  id            String   @id @default(cuid())
  naziv         String   @unique  // npr. "Laser Bosch GLM 50C", "Vijačnik", "Avtomobil A"
  tip           String   // "MERSKA_OPREMA" | "ROČNO_ORODJE" | "PREVOZ" | "VARNOSTNA_OPREMA" | "OSTALO"
  sifra         String?
  status        String   @default("NA_VOLJO")  // NA_VOLJO | V_UPORABI | V_SERVISU | IZGUBLJENO
  lokacija      String?  // npr. "Skladišče Kranj", "Avto A"
  zadnjiServis  DateTime?
  opomba        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments   EquipmentAssignment[]

  @@index([status])
}

// Termin montaže v koledarju
model InstallationSchedule {
  id            String    @id @default(cuid())
  projectId     String
  crewId        String?
  monterId      String?   // glavni monter (Profile.id)
  datumZacetka  DateTime
  datumKonca    DateTime
  status        String    @default("NAVRTENO")  // NAVRTENO | V_TEKU | ZAKLJUCENO | PREKlicANO | PRELOZENO
  predvideneUre Int       @default(8)
  dejanskeUre   Int?
  opombe        String?
  lokacija      String?   // naslov montaže
  gpsLat        Float?
  gpsLon        Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project   @relation(fields: [projectId], references: [id])
  crew          Crew?     @relation(fields: [crewId], references: [id])
  monter        Profile?  @relation("MonterSchedules", fields: [monterId], references: [id])
  equipment     EquipmentAssignment[]

  @@index([datumZacetka])
  @@index([crewId])
  @@index([status])
}

// Oprema dodeljena terminu montaže
model EquipmentAssignment {
  id            String   @id @default(cuid())
  scheduleId    String
  equipmentId   String
  datumOd       DateTime
  datumDo       DateTime
  opomba        String?
  createdAt     DateTime @default(now())

  schedule      InstallationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  equipment     Equipment            @relation(fields: [equipmentId], references: [id])

  @@index([scheduleId])
  @@index([equipmentId])
}
