  projectId   String
  kotStopinje Float // nagib v stopinjah
  smer        String? // "X" (horizontal) / "Y" (front-back)
  lokacija    String? // opis npr. "talna plošča balkona"
  veljaven    Boolean  @default(true)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// 16. SLIKE PROJEKTA (pred/med/po montaži)
// ============================================

model ProjectPhoto {
  id         String   @id @default(cuid())
  projectId  String
  kategorija String // "PRED" | "MED" | "PO"
  // R121: bajti v object storage, DB samo metadata. imageData ostane SAMO za
  // zapuščinske vrstice pred backfillom (tools/migrate-base64-to-storage.ts).
  imageData  String?
  storageKey String?
  mime       String?
  sizeBytes  Int?
  sha256     String?
  opomba     String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceBefore InstallationEvidence[] @relation("EvidenceBeforePhoto") // R147 §28 — dokazila s to PRED fotko
  evidenceAfter  InstallationEvidence[] @relation("EvidenceAfterPhoto") // R147 §28 — dokazila s to PO fotko

  @@index([storageKey])
